---
import VoteBar from "./VoteBar.astro";
import { fmtShort, fmtTime, resultText, resultCls, shortTitle, voteHeadline, voteContext, type Vote } from "../lib/data";
interface Props { items: Vote[]; showDate?: boolean; showContext?: boolean }
const { items, showDate = true, showContext = true } = Astro.props;
---
<ul class="votes">
  {items.map((v) => { const ctx = showContext ? voteContext(v) : null; return (
    <li>
      <time datetime={v.datetime}>{showDate ? fmtShort(v.datetime) : fmtTime(v.datetime)}</time>
      <span class="t">
        <a href={`/hlasovania/${v.id}/`} title={v.title}>{shortTitle(voteHeadline(v), 160)}</a>
        {ctx && <small class="ctx">{v.tlac ? <a href={`/zakony/${v.tlac}/`}>{shortTitle(ctx, 120)}</a> : shortTitle(ctx, 120)}</small>}
      </span>
      <VoteBar counts={v.counts} />
      <span class="res"><span class={`pill ${resultCls(v)}`}>{resultText(v)}</span></span>
    </li>
  ); })}
</ul>
