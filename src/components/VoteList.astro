---
import VoteBar from "./VoteBar.astro";
import { fmtShort, fmtTime, resultText, resultCls, shortTitle, type Vote } from "../lib/data";
interface Props { items: Vote[]; showDate?: boolean }
const { items, showDate = true } = Astro.props;
---
<ul class="votes">
  {items.map((v) => (
    <li>
      <time datetime={v.datetime}>{showDate ? fmtShort(v.datetime) : fmtTime(v.datetime)}</time>
      <span class="t"><a href={`/hlasovania/${v.id}/`} title={v.title}>{shortTitle(v.title, 180)}</a></span>
      <VoteBar counts={v.counts} />
      <span class="res"><span class={`pill ${resultCls(v)}`}>{resultText(v)}</span></span>
    </li>
  ))}
</ul>
