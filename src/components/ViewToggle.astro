---
// 3D / 2D switch for every hall on the page; the choice is remembered in this browser.
---
<div class="seg view-toggle" role="group" aria-label="Zobrazenie sály">
  <button type="button" data-view="3d" aria-pressed="true">3D</button>
  <button type="button" data-view="2d" aria-pressed="false">2D</button>
</div>
<script>
  const btns = () => document.querySelectorAll<HTMLButtonElement>(".view-toggle button");
  const sync = (m: string) => btns().forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === m)));
  let m = "3d"; try { m = localStorage.getItem("fp-hall") || "3d"; } catch {}
  sync(m);
  document.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>(".view-toggle button"); if (!b) return;
    const v = b.dataset.view!; try { localStorage.setItem("fp-hall", v); } catch {}
    sync(v); document.dispatchEvent(new CustomEvent("fp:hall-view", { detail: v }));
  });
</script>
