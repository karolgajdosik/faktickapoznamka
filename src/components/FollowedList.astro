---
interface Props { always?: boolean }
const { always = false } = Astro.props;
---
<section id="follows" hidden={!always} data-always={always ? "1" : undefined}>
        {!always && <div class="section-head"><h2>Poslanci, ktorých sledujete</h2><a href="/poslanci/">Pridať ďalších</a></div>}
        <div class="follows" id="follows-list"></div>
        <div class="panel pad" id="follows-empty" hidden><h3 style="margin-top:0">Zatiaľ nikoho nesledujete</h3><p class="muted">V sále otvorte kartu poslanca a ťuknite na Sledovať. Jeho vystúpenia a hlasovania proti klubu sa potom zobrazia tu.</p><a class="more" href="/poslanci/">Otvoriť sálu</a></div>
      </section>
      <script>
        (async () => {
          const box = document.getElementById("follows")!, list = document.getElementById("follows-list")!;
          let ids: string[] = []; try { ids = JSON.parse(localStorage.getItem("fp-follow") || "[]"); } catch {}
          if (!ids.length) { if (box.dataset.always === "1") document.getElementById("follows-empty")?.removeAttribute("hidden"); return; }
          
          const el = (t: string, p: Record<string, any> = {}, ...k: (Node | string | null)[]) => { const e = document.createElement(t); Object.assign(e, p); for (const c of k) if (c != null) e.append(c); return e; };
          const data = (await Promise.all(ids.map((id) => fetch(`/poslanci/${id}/aktivita.json`).then((r) => (r.ok ? r.json() : null)).catch(() => null)))).filter(Boolean);
          for (const m of data) {
            const ava = el("span", { className: `ava${m.photo ? " img" : ""}`, ariaHidden: "true" }); if (m.photo) ava.append(el("img", { src: m.photo, alt: "" })); else ava.textContent = m.ini;
            const card = el("article", { className: "panel fcard" },
              el("header", {}, ava, el("div", {}, el("a", { href: `/poslanci/${m.id}/`, textContent: m.name }), el("small", { textContent: m.club }))),
              m.items.length ? el("ul", {}, ...m.items.map((i: any) => el("li", {}, el("a", { href: i.u }, el("b", { textContent: i.t }), el("span", { textContent: `${i.d.split("-").reverse().map(Number).join(". ")}: ${i.x}` })))))
                : el("p", { className: "empty", textContent: "Zatiaľ žiadna nová aktivita." }));
            card.style.setProperty("--club", m.color); list.append(card);
          }
          box.hidden = !data.length && box.dataset.always !== "1";
          if (!data.length) document.getElementById("follows-empty")?.removeAttribute("hidden");
        })();
      </script>
