---
import { safeJson } from "../lib/safejson";
// The plenary hall: one seat per MP, ring = club colour, fill = vote (vote mode).
// Clubs fill the hemicycle left→right by size (neutral, not political left/right).
import { clubs, mps as current, mpById, clubColor, initials, photo, LABEL, cls, mpStats, pct, age, talk, fmtDur, type Code, type Mp } from "../lib/data";
import { committeesOf } from "../lib/extra";
interface Props { votes?: Record<string, Code>; clubsAt?: Record<string, string>; id?: string; intro?: boolean; label?: string }
const { votes, clubsAt, id = "hall", intro = false, label = "Sála Národnej rady SR" } = Astro.props;

const people: Mp[] = votes
  ? Object.keys(votes).map((k) => mpById.get(k)).filter((m): m is Mp => !!m)
  : current;
const clubOf = (m: Mp) => clubsAt?.[m.id] ?? m.club;
// Facts for the hover card (one compact record per seat).
const info = Object.fromEntries(people.map((m) => {
  const st = mpStats(m.id), t = talk.get(m.id), a = age(m.born);
  const roles = committeesOf(m.id).filter((c) => c.role === "predseda" || c.role === "podpredseda").map((c) => `${c.label} výboru: ${c.short.replace(/ NR SR$/, "")}`);
  return [m.id, { t: m.title ?? "", age: a, place: [m.city, m.region && (/kraj$/.test(m.region) ? m.region : `${m.region} kraj`)].filter(Boolean).join(", "), att: st.attendance, loy: st.loyalty, reb: st.rebels.length,
    talk: t ? fmtDur(t.seconds) : "", sp: t?.count ?? 0, role: roles[0] ?? "" }];
}));
const total = people.length;
const W = 1000, CX = 500, CY = 500, RO = 478, RI = 0.36;
const rows = 7;
const radii = Array.from({ length: rows }, (_, i) => RI + ((1 - RI) * i) / (rows - 1));
const sumR = radii.reduce((a, b) => a + b, 0);
const perRow = radii.map((r) => Math.floor((total * r) / sumR));
let rest = total - perRow.reduce((a, b) => a + b, 0);
for (let i = rows - 1; rest > 0; i = (i - 1 + rows) % rows, rest--) perRow[i]++;
const seats: { x: number; y: number; a: number; row: number }[] = [];
radii.forEach((r, i) => {
  const n = perRow[i];
  for (let k = 0; k < n; k++) {
    const a = n === 1 ? Math.PI / 2 : Math.PI - (Math.PI * k) / (n - 1);
    seats.push({ x: CX + RO * r * Math.cos(a), y: CY - RO * r * Math.sin(a), a, row: i });
  }
});
// 3D view: the floor is tilted (vertical distances shrink), far rows are smaller and higher.
const TILT = 0.74, Y0 = 478;
const to3 = (s: { x: number; y: number; row: number }) => ({
  x: s.x, y: Y0 - (CY - s.y) * TILT - s.row * 3, k: 1 - 0.24 * (s.row / (rows - 1)),
});
seats.sort((p, q) => q.a - p.a || Math.hypot(p.x - CX, p.y - CY) - Math.hypot(q.x - CX, q.y - CY));
const order: Code[] = ["Z", "?", "N", "P", "0"];
const clubIdx = new Map(clubs.map((c, i) => [c.name, i]));
const sorted = people.slice().sort((a, b) =>
  ((clubIdx.get(clubOf(a)) ?? 99) - (clubIdx.get(clubOf(b)) ?? 99)) ||
  (votes ? order.indexOf(votes[a.id]) - order.indexOf(votes[b.id]) : 0) ||
  a.sortName.localeCompare(b.sortName, "sk"));
const R = Math.min(17, (RO * (1 - RI) / (rows - 1)) * 0.43);
// draw far rows first so nearer seats overlap them in 3D
const drawOrder = sorted.map((m, i) => ({ m, i, s: seats[i] })).sort((p, q) => q.s.row - p.s.row || p.s.x - q.s.x);
const floorRows = radii.map((r, i) => ({ rx: RO * r + R * 1.3, ry: (RO * r + R * 1.3) * TILT, cy: Y0 - i * 4 + R * 1.6 })).reverse();
---
<div class:list={["hall", "d3", { intro }]} id={id} data-mode={votes ? "vote" : "club"} data-vb2={`0 -12 ${W} 560`} data-vb3={`0 100 ${W} 470`}>
  <svg viewBox={`0 100 ${W} 470`} role="img" aria-label={label} translate="no">
    <defs>
      <radialGradient id={`${id}-glow`} cx="50%" cy="100%" r="60%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity=".16" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
      </radialGradient>
      <linearGradient id={`${id}-chair`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".35" />
        <stop offset=".45" stop-color="#fff" stop-opacity="0" />
        <stop offset="1" stop-color="#000" stop-opacity=".45" />
      </linearGradient>
    </defs>
    <g class="flat-only">
      <ellipse cx={CX} cy={CY} rx={RO + 20} ry={RO * .62} fill={`url(#${id}-glow)`} />
      <path d={`M ${CX - RO - 22} ${CY + 22} A ${RO + 22} ${RO + 22} 0 0 1 ${CX + RO + 22} ${CY + 22}`} fill="none" stroke="var(--line)" stroke-width="1" />
      <rect class="podium" x={CX - 70} y={CY - 28} width="140" height="34" rx="8" />
      <text class="podium-label" x={CX} y={CY + 30}>PREDSEDNÍCTVO</text>
    </g>
    <g class="d3-only floor" aria-hidden="true">
      <ellipse cx={CX} cy={Y0 + 30} rx={RO + 60} ry={(RO + 60) * TILT} fill={`url(#${id}-glow)`} />
      {floorRows.map((f) => <path d={`M ${CX - f.rx} ${f.cy} A ${f.rx} ${f.ry} 0 0 1 ${CX + f.rx} ${f.cy}`} class="step" />)}
      <path class="desk" d={`M ${CX - 92} ${Y0 + 22} L ${CX + 92} ${Y0 + 22} L ${CX + 78} ${Y0 - 2} L ${CX - 78} ${Y0 - 2} Z`} />
      <path class="desk-front" d={`M ${CX - 92} ${Y0 + 22} L ${CX + 92} ${Y0 + 22} L ${CX + 92} ${Y0 + 40} L ${CX - 92} ${Y0 + 40} Z`} />
      {[-3, -2, -1, 0, 1, 2, 3].map((k) => <rect class="desk-seat" x={CX + k * 22 - 7} y={Y0 + 4} width="14" height="9" rx="2" />)}
      <text class="podium-label" x={CX} y={Y0 + 64}>PREDSEDNÍCTVO</text>
    </g>
    {drawOrder.map(({ m, i, s }) => {
      const c = votes?.[m.id]; const club = clubOf(m); const d = to3(s);
      return (
        <g class:list={["seat", c && `v-${cls(c)}`]}
           style={`--club:${clubColor(club)};--i:${i};--x2:${s.x.toFixed(1)}px;--y2:${s.y.toFixed(1)}px;--x3:${d.x.toFixed(1)}px;--y3:${d.y.toFixed(1)}px;--k3:${d.k.toFixed(3)}`}
           data-id={m.id} data-name={m.name} data-club={club} data-vote={c ? LABEL[c] : ""} data-photo={photo(m.id) ?? ""} data-ini={initials(m)} data-att={mpStats(m.id).attendance != null ? pct(mpStats(m.id).attendance) : ""} tabindex="0" role="link"
           aria-label={`${m.name}, ${club}${c ? `: ${LABEL[c].toLowerCase()}` : ""}`}>
          <g class="chair" aria-hidden="true">
            <ellipse class="shadow" cx="0" cy={(R * 1.95).toFixed(1)} rx={(R * 1.05).toFixed(1)} ry={(R * .38).toFixed(1)} />
            <path class="back" d={`M ${(-R * .78).toFixed(1)} ${(R * .2).toFixed(1)} L ${(R * .78).toFixed(1)} ${(R * .2).toFixed(1)} L ${(R * .62).toFixed(1)} ${(R * 1.9).toFixed(1)} Q 0 ${(R * 2.15).toFixed(1)} ${(-R * .62).toFixed(1)} ${(R * 1.9).toFixed(1)} Z`} />
            <path class="sheen" fill={`url(#${id}-chair)`} d={`M ${(-R * .78).toFixed(1)} ${(R * .2).toFixed(1)} L ${(R * .78).toFixed(1)} ${(R * .2).toFixed(1)} L ${(R * .62).toFixed(1)} ${(R * 1.9).toFixed(1)} Q 0 ${(R * 2.15).toFixed(1)} ${(-R * .62).toFixed(1)} ${(R * 1.9).toFixed(1)} Z`} />
          </g>
          <g class="pop">
            <circle r={R.toFixed(1)} />
            {photo(m.id) && !votes
              ? <image href={photo(m.id)!} x={(-R + 2.2).toFixed(1)} y={(-R + 2.2).toFixed(1)} width={(2 * R - 4.4).toFixed(1)} height={(2 * R - 4.4).toFixed(1)} preserveAspectRatio="xMidYMid slice" />
              : <text aria-hidden="true">{initials(m)}</text>}
          </g>
        </g>
      );
    })}
  </svg>
  <div class="tip" hidden></div>
  <script type="application/json" class="hall-info" set:html={safeJson(info)} />
</div>
<script>
  // Tooltip + default click (go to MP page). Pages can override by listening to "seat:select".
  for (const hall of document.querySelectorAll<HTMLElement>(".hall")) {
    const tip = hall.querySelector<HTMLElement>(".tip")!;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    let lifted: { g: SVGGElement; next: Node | null } | null = null;
    const lift = (g: SVGGElement) => {
      if (!fine || lifted?.g === g) return;
      drop();
      lifted = { g, next: g.nextSibling }; g.parentNode!.appendChild(g); // paint above neighbours
      hall.classList.add("hovering"); hall.style.setProperty("--spot", g.dataset.club ?? "");
      for (const s of hall.querySelectorAll<SVGGElement>(".seat")) s.classList.toggle("same", s.dataset.club === g.dataset.club);
      requestAnimationFrame(() => g.classList.add("up"));
    };
    const drop = () => {
      if (!lifted) return;
      const { g, next } = lifted; lifted = null;
      g.classList.remove("up"); g.parentNode!.insertBefore(g, next);
      hall.classList.remove("hovering");
    };
    const info = JSON.parse(hall.querySelector(".hall-info")?.textContent || "{}") as Record<string, { t: string; age: number | null; place: string; att: number | null; loy: number | null; reb: number; talk: string; sp: number; role: string }>;
    const P = (x: number | null) => (x == null ? "–" : `${(x * 100 > 99 && x < 1 ? (x * 100).toFixed(1).replace(".", ",") : Math.round(x * 100))} %`);
    const E = (tag: string, cls: string, text?: string) => { const e = document.createElement(tag); e.className = cls; if (text !== undefined) e.textContent = text; return e; };
    const show = (g: SVGGElement) => {
      const r = g.getBoundingClientRect(), h = hall.getBoundingClientRect();
      const d = info[g.dataset.id!]; const club = getComputedStyle(g).getPropertyValue("--club");
      tip.innerHTML = ""; tip.classList.toggle("rich", fine);
      if (!fine || !d) {
        const extra = g.dataset.extra || g.dataset.vote || (g.dataset.att ? `účasť ${g.dataset.att}` : "");
        const b = E("b", "", g.dataset.name!); const s = E("span", "", g.dataset.club + (extra ? ` · ${extra}` : "")); tip.append(b, s);
      } else {
        tip.style.setProperty("--club", club);
        const head = E("div", "tc-head");
        const ph = E("span", "tc-ph");
        if (g.dataset.photo) { const img = document.createElement("img"); img.src = g.dataset.photo; img.alt = ""; ph.append(img); } else ph.textContent = g.dataset.ini ?? "";
        const who = E("div", "tc-who");
        const nm = E("b", "tc-name", g.dataset.name!); nm.translate = false; const cb = E("span", "tc-club", g.dataset.club!); cb.translate = false; who.append(nm, cb);
        const meta = [d.t, d.age ? `${d.age} r.` : "", d.place].filter(Boolean).join(", ");
        if (meta) who.append(E("span", "tc-meta", meta));
        if (d.role) who.append(E("span", "tc-role", d.role));
        head.append(ph, who); tip.append(head);
        if (g.dataset.vote || g.dataset.extra) tip.append(E("div", "tc-vote", g.dataset.extra || `Hlasoval(a): ${g.dataset.vote}`));
        const stats = E("dl", "tc-stats");
        const add = (k: string, v: string) => { const w = E("div", ""); w.append(E("dt", "", k), E("dd", "", v)); stats.append(w); };
        add("Účasť", P(d.att)); add("Súlad s klubom", P(d.loy)); add("Proti klubu", `${d.reb}×`); add("V rozprave", d.talk || "–");
        tip.append(stats, E("span", "tc-hint", "Kliknutím otvoríte profil"));
      }
      tip.hidden = false;
      const half = tip.offsetWidth / 2, x = r.left - h.left + r.width / 2; // keep the card inside the hall
      tip.style.left = `${Math.min(Math.max(x, half + 8), h.width - half - 8)}px`;
      // above the seat if there is room, otherwise below it
      const above = r.top - h.top - (fine ? r.height * .6 : 0);
      const below = above - tip.offsetHeight - 30 < -h.top + 70 && fine;
      tip.classList.toggle("below", below);
      tip.style.top = `${below ? r.bottom - h.top + r.height * .6 : above}px`;
      tip.classList.remove("in"); void tip.offsetWidth; tip.classList.add("in");
    };
    const hide = () => { tip.hidden = true; };
    const select = (g: SVGGElement) => {
      const ev = new CustomEvent("seat:select", { detail: g.dataset.id, cancelable: true, bubbles: true });
      if (hall.dispatchEvent(ev)) location.href = `/poslanci/${g.dataset.id}/`;
    };
    hall.addEventListener("pointerover", (e) => { const g = (e.target as Element).closest<SVGGElement>(".seat"); if (g) { lift(g); show(g); } });
    hall.addEventListener("pointerout", (e) => {
      const from = (e.target as Element).closest(".seat"), to = (e.relatedTarget as Element | null)?.closest?.(".seat");
      if (from && from !== to) { hide(); if (!to) drop(); }
    });
    hall.addEventListener("pointerleave", () => { hide(); drop(); });
    // The MP list next to the hall can point at a seat (hover a name → that seat lifts).
    hall.addEventListener("seat:hover", (e) => {
      const id = (e as CustomEvent).detail as string | null;
      const g = id ? hall.querySelector<SVGGElement>(`.seat[data-id="${id}"]`) : null;
      if (g && !hall.classList.contains("filtered") || g?.classList.contains("match")) { lift(g!); show(g!); } else { hide(); drop(); }
    });
    hall.addEventListener("focusin", (e) => { const g = (e.target as Element).closest<SVGGElement>(".seat"); if (g) show(g); });
    hall.addEventListener("focusout", hide);
    hall.addEventListener("click", (e) => { const g = (e.target as Element).closest<SVGGElement>(".seat"); if (g) select(g); });
    hall.addEventListener("keydown", (e) => { const g = (e.target as Element).closest<SVGGElement>(".seat"); if (g && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); select(g); } });
    setTimeout(() => hall.classList.remove("intro"), 1500);
    let pref = "3d"; try { pref = localStorage.getItem("fp-hall") || "3d"; } catch {}
    const svg = hall.querySelector("svg")!;
    const apply = (m: string) => { hall.classList.toggle("d3", m === "3d"); svg.setAttribute("viewBox", m === "3d" ? hall.dataset.vb3! : hall.dataset.vb2!); };
    apply(pref);
    document.addEventListener("fp:hall-view", (e) => apply((e as CustomEvent).detail));
  }
</script>
