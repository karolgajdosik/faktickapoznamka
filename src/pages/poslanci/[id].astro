---
import Base from "../../layouts/Base.astro";
import MpCard from "../../components/MpCard.astro";
import VoteList from "../../components/VoteList.astro";
import { mps, formerMps, votes, mpStats, pct, type Mp } from "../../lib/data";
export function getStaticPaths() { return [...mps, ...formerMps].map((m) => ({ params: { id: m.id }, props: { m } })); }
const { m } = Astro.props as { m: Mp };
const s = mpStats(m.id);
const history = votes.filter((v) => v.votes[m.id]).slice(0, 30);
---
<Base index ogImage={`/og/poslanec/${m.id}.png`} title={m.name} description={`${m.name} (${m.club}): účasť na hlasovaniach ${pct(s.attendance)}, súlad s klubom ${pct(s.loyalty)}.`}>
  <MpCard m={m} />
  <div class="section-head"><h2>Posledné hlasovania</h2></div>
  <VoteList items={history} />
  <p><a class="more" href={`https://www.nrsr.sk/web/Default.aspx?sid=poslanci/poslanec&PoslanecID=${m.id}`} rel="noopener">Profil na nrsr.sk</a></p>
</Base>
