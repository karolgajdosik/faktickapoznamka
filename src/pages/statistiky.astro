---
import { safeJson } from "../lib/safejson";
// Interactive statistics: MP leaderboards with switchable metric, clubs compared,
// the term over time, and close votes. Server builds compact JSON; the browser does the rest.
import Base from "../layouts/Base.astro";
import VoteList from "../components/VoteList.astro";
import { cohesion, agreement, agreementClubs, monthly, speechTotals, closeVotes, failed } from "../lib/stats";
import { absence, mpExtra, isApproved, hasExtra } from "../lib/extra";
import { votes, sessions, mps, clubColor, mpStats, talk, speeches, CHAIR, photo, initials, fmtDur, laws, NEZ, dayKey } from "../lib/data";

const passedLaws = laws.filter((l) => l.status === "schválený").length;
const people = mps.map((m) => {
  const s = mpStats(m.id), t = talk.get(m.id), x = mpExtra.get(m.id), a = absence.get(m.id), d = x?.declaration;
  const bills = x?.bills.length ?? null, ok = x ? x.bills.filter(isApproved).length : null;
  return {
    id: m.id, n: m.name, s: m.sortName, c: m.club, col: clubColor(m.club), p: photo(m.id), i: initials(m),
    att: s.attendance, loy: s.loyalty, reb: s.rebels.length,
    unex: a?.unexcused ?? null, talk: t?.seconds ?? 0, spk: t?.count ?? 0, fact: t?.factual ?? 0,
    bills, billsOk: ok, rate: bills ? (ok ?? 0) / bills : null, amend: x?.amendments.length ?? null, interp: x?.interpellations.length ?? null,
    trips: x?.trips.length ?? null, inc: d ? d.incomeOther ?? 0 : null, re: d ? d.realEstateCount : null,
  };
});
const clubNames = [...new Set(mps.map((m) => m.club))].sort((a, b) => (a === NEZ ? 1 : b === NEZ ? -1 : mps.filter((m) => m.club === b).length - mps.filter((m) => m.club === a).length));
const avg = (xs: (number | null)[]) => { const v = xs.filter((x): x is number => x !== null); return v.length ? v.reduce((a, b) => a + b, 0) / v.length : null; };
const sum = (xs: (number | null)[]) => xs.reduce<number>((a, b) => a + (b ?? 0), 0);
const clubData = clubNames.map((c) => {
  const ps = people.filter((p) => p.c === c);
  const i = agreementClubs.indexOf(c);
  return { c, col: clubColor(c), seats: ps.length, coh: cohesion.find((x) => x.club === c)?.value ?? null, att: avg(ps.map((p) => p.att)),
    talk: avg(ps.map((p) => p.talk)), bills: sum(ps.map((p) => p.bills)), ok: sum(ps.map((p) => p.billsOk)), interp: sum(ps.map((p) => p.interp)), reb: sum(ps.map((p) => p.reb)),
    agr: i < 0 ? null : Object.fromEntries(agreementClubs.map((o, j) => [o, agreement[i][j]]).filter(([o]) => o !== c)) };
});
const talkByMonth = new Map<string, number>();
for (const x of speeches) if (x.kind !== CHAIR) talkByMonth.set(x.start.slice(0, 7), (talkByMonth.get(x.start.slice(0, 7)) ?? 0) + x.dur);
const firstDay = new Map<string, string>();
for (const v of votes) { const d = dayKey(v.datetime), k = d.slice(0, 7); if (!firstDay.has(k) || d < firstDay.get(k)!) firstDay.set(k, d); }
const months = monthly.map((m) => ({ m: m.month, n: m.n, att: m.attendance, ok: m.passed, talk: (talkByMonth.get(m.month) ?? 0) / 3600, d: firstDay.get(m.month) ?? `${m.month}-01` }));
const data = { people, clubs: clubData, months, hasExtra, nez: NEZ };
---
<Base title="Štatistiky" description="Interaktívne štatistiky NR SR: rebríčky poslancov podľa účasti, rozpravy, návrhov zákonov a príjmov, porovnanie klubov a vývoj v čase.">
  <h1>Štatistiky</h1>
  <p class="meta-line">IX. volebné obdobie, od 25. 10. 2023. Metodika je na stránke <a href="/o-projekte/#metodika">O projekte</a>.</p>
  <dl class="tiles kpis">
    <div class="tile"><dt>Hlasovaní</dt><dd>{votes.length.toLocaleString("sk-SK")}</dd></div>
    <div class="tile"><dt>Neschválených</dt><dd>{failed.toLocaleString("sk-SK")}</dd></div>
    <div class="tile"><dt>Schválených zákonov</dt><dd>{passedLaws}</dd></div>
    <div class="tile"><dt>Schôdzí</dt><dd>{sessions.length}</dd></div>
    <div class="tile"><dt>Vystúpení</dt><dd>{speechTotals.count.toLocaleString("sk-SK")}</dd></div>
    <div class="tile accent"><dt>Čas rozpravy</dt><dd>{Math.round(speechTotals.seconds / 3600).toLocaleString("sk-SK")}<small>hodín</small></dd></div>
  </dl>

  <div class="st-tabs" role="tablist" aria-label="Pohľad">
    <button role="tab" id="t-rebricky" aria-controls="p-rebricky" aria-selected="true">Poslanci</button>
    <button role="tab" id="t-kluby" aria-controls="p-kluby" aria-selected="false">Kluby</button>
    <button role="tab" id="t-vcase" aria-controls="p-vcase" aria-selected="false">V čase</button>
    <button role="tab" id="t-tesne" aria-controls="p-tesne" aria-selected="false">Tesné<span class="wide"> hlasovania</span></button>
  </div>

  <section role="tabpanel" id="p-rebricky" aria-labelledby="t-rebricky" class="panel st-panel">
    <div class="metrics" id="metrics" role="radiogroup" aria-label="Ukazovateľ"></div>
    <div class="lb-ctl">
      <div class="seg" role="group" aria-label="Poradie"><button type="button" id="ord-desc" aria-pressed="true">Najviac</button><button type="button" id="ord-asc" aria-pressed="false">Najmenej</button></div>
      <div class="clubchips" id="clubchips" role="group" aria-label="Klub"></div>
      <label class="lb-find"><span class="sr-only">Nájsť poslanca</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="lb-q" type="search" placeholder="Nájsť poslanca" autocomplete="off" /></label>
    </div>
    <p class="lb-desc" id="lb-desc"></p>
    <div class="lb-sum" id="lb-sum"></div>
    <ol class="lb" id="lb"></ol>
    <button type="button" class="lb-more" id="lb-more" hidden>Zobraziť všetkých</button>
  </section>

  <section role="tabpanel" id="p-kluby" aria-labelledby="t-kluby" class="panel st-panel" hidden>
    <div class="metrics" id="cmetrics" role="radiogroup" aria-label="Porovnať kluby podľa"></div>
    <p class="lb-desc" id="c-desc"></p>
    <div class="cbars" id="cbars"></div>
    <h3 class="st-h3">Ako často hlasuje klub rovnako ako ostatné</h3>
    <div class="clubchips" id="agrchips" role="group" aria-label="Vybrať klub"></div>
    <div class="cbars" id="agrbars"></div>
    <details class="st-details"><summary>Celá tabuľka zhody klubov</summary>
      <div style="overflow-x:auto"><table class="matrix">
        <thead><tr><th></th>{agreementClubs.map((c) => <th style={`--club:${clubColor(c)}`}><span>{c}</span></th>)}</tr></thead>
        <tbody>{agreementClubs.map((a, i) => (
          <tr><th style={`--club:${clubColor(a)}`}>{a}</th>{agreement[i].map((x, j) => (
            <td style={i === j ? "" : `--a:${x ?? 0}`} class={i === j ? "self" : ""}>{i === j ? "" : x === null ? "–" : `${Math.round(x * 100)} %`}</td>
          ))}</tr>
        ))}</tbody>
      </table></div>
    </details>
  </section>

  <section role="tabpanel" id="p-vcase" aria-labelledby="t-vcase" class="panel st-panel" hidden>
    <div class="metrics" id="tmetrics" role="radiogroup" aria-label="Ukazovateľ v čase"></div>
    <p class="lb-desc" id="t-desc"></p>
    <div class="tchart" id="tchart"></div>
    <div class="taxis" id="taxis"></div>
    <div class="tinfo" id="tinfo" aria-live="polite"></div>
  </section>

  <section role="tabpanel" id="p-tesne" aria-labelledby="t-tesne" class="st-panel plain" hidden>
    <p class="lb-desc">Hlasovania, o ktorých rozhodlo najviac pár hlasov.</p>
    <VoteList items={closeVotes} />
  </section>

  <script type="application/json" id="st-data" set:html={safeJson(data)} />
</Base>

<script>
  type P = Record<string, any>;
  const D = JSON.parse(document.getElementById("st-data")!.textContent!) as { people: P[]; clubs: P[]; months: P[]; hasExtra: boolean; nez: string };
  const $ = (id: string) => document.getElementById(id)!;
  const nf = (x: number, d = 0) => x.toLocaleString("sk-SK", { maximumFractionDigits: d, minimumFractionDigits: d });
  const pc = (x: number | null) => (x == null ? "–" : `${nf(x * 100, x > 0.99 && x < 1 ? 1 : 0)} %`);
  const dur = (s: number) => { const h = Math.floor(s / 3600), m = Math.round((s % 3600) / 60); return h ? `${h} h ${m} min` : `${m} min`; };
  const eur = (x: number) => `${nf(x)} €`;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  /* ---------- tabs ---------- */
  const tabs = ["rebricky", "kluby", "vcase", "tesne"];
  function tab(name: string, push = true) {
    if (!tabs.includes(name)) name = "rebricky";
    for (const t of tabs) { $(`t-${t}`).setAttribute("aria-selected", String(t === name)); $(`p-${t}`).hidden = t !== name; ($(`t-${t}`) as HTMLButtonElement).tabIndex = t === name ? 0 : -1; }
    if (push) history.replaceState(null, "", `#${name}${name === "rebricky" ? `-${metric}` : ""}`);
  }
  for (const t of tabs) $(`t-${t}`).addEventListener("click", () => tab(t));
  $("t-rebricky").parentElement!.addEventListener("keydown", (e) => {
    const i = tabs.findIndex((t) => $(`t-${t}`).getAttribute("aria-selected") === "true");
    const j = e.key === "ArrowRight" ? (i + 1) % tabs.length : e.key === "ArrowLeft" ? (i + tabs.length - 1) % tabs.length : -1;
    if (j >= 0) { tab(tabs[j]); $(`t-${tabs[j]}`).focus(); }
  });

  /* ---------- MP leaderboards ---------- */
  type M = { k: string; l: string; d: string; f: (v: number, p: P) => string; extra?: boolean; asc?: boolean; min?: (p: P) => boolean };
  const METRICS: M[] = [
    { k: "att", l: "Účasť", d: "Podiel hlasovaní, na ktorých bol poslanec prítomný.", f: (v) => pc(v) },
    { k: "unex", l: "Neospravedlnená neprítomnosť", d: "Hlasovania, na ktorých chýbal bez ospravedlnenia na daný deň.", f: (v) => `${nf(v)} hlasovaní`, extra: true },
    { k: "loy", l: "Súlad s klubom", d: "Podiel hlasovaní, v ktorých hlasoval rovnako ako väčšina jeho klubu.", f: (v) => pc(v), min: (p) => p.c !== D.nez },
    { k: "reb", l: "Hlasovania proti klubu", d: "Koľkokrát hlasoval inak ako väčšina vlastného klubu.", f: (v) => `${nf(v)}×` },
    { k: "talk", l: "Čas v rozprave", d: "Celkový čas pri rečníckom pulte (bez vedenia schôdze).", f: (v) => dur(v) },
    { k: "spk", l: "Počet vystúpení", d: "Všetky vystúpenia v rozprave vrátane faktických poznámok.", f: (v) => nf(v) },
    { k: "fact", l: "Faktické poznámky", d: "Krátke reakcie na predrečníka.", f: (v) => nf(v) },
    { k: "bills", l: "Návrhy zákonov", d: "Návrhy zákonov, ktoré poslanec predložil alebo spolupredložil.", f: (v, p) => (p?.billsOk != null ? `${nf(v)} (${nf(p.billsOk)} schválených)` : nf(v)), extra: true },
    { k: "rate", l: "Úspešnosť návrhov", d: "Podiel schválených z jeho návrhov zákonov (len poslanci s aspoň 3 návrhmi).", f: (v, p) => (p?.bills != null ? `${pc(v)} z ${p.bills}` : pc(v)), extra: true, min: (p) => (p.bills ?? 0) >= 3 },
    { k: "amend", l: "Pozmeňujúce návrhy", d: "Podané pozmeňujúce a doplňujúce návrhy.", f: (v) => nf(v), extra: true },
    { k: "interp", l: "Interpelácie", d: "Otázky adresované vláde a ministrom.", f: (v) => nf(v), extra: true },
    { k: "trips", l: "Zahraničné cesty", d: "Zahraničné pracovné cesty podľa nrsr.sk.", f: (v) => nf(v), extra: true },
    { k: "inc", l: "Iné príjmy", d: "Príjmy mimo výkonu funkcie poslanca podľa majetkového priznania.", f: (v) => eur(v), extra: true },
    { k: "re", l: "Nehnuteľnosti", d: "Počet nehnuteľností v majetkovom priznaní.", f: (v) => nf(v), extra: true },
  ].filter((m) => !m.extra || D.hasExtra);
  let metric = "att", asc = false, club = "", q = "", all = false;

  $("metrics").innerHTML = METRICS.map((m) => `<button type="button" role="radio" data-k="${m.k}">${m.l}</button>`).join("");
  const clubs = D.clubs.map((c) => c.c);
  $("clubchips").innerHTML = `<button type="button" data-c="" aria-pressed="true">Všetci</button>` + clubs.map((c) => `<button type="button" data-c="${esc(c)}" aria-pressed="false" style="--club:${D.clubs.find((x) => x.c === c)!.col}"><i></i>${esc(c)}</button>`).join("");

  function lb() {
    const M = METRICS.find((m) => m.k === metric)!;
    for (const b of $("metrics").querySelectorAll("button")) b.setAttribute("aria-checked", String(b.dataset.k === metric));
    for (const b of $("clubchips").querySelectorAll("button")) b.setAttribute("aria-pressed", String(b.dataset.c === club));
    $("ord-desc").setAttribute("aria-pressed", String(!asc)); $("ord-asc").setAttribute("aria-pressed", String(asc));
    $("lb-desc").textContent = M.d;
    const chip = $("metrics").querySelector(`[data-k="${metric}"]`) as HTMLElement | null; if (chip) $("metrics").scrollLeft = Math.max(0, chip.offsetLeft - 24);
    const valid = D.people.filter((p) => p[metric] != null && (!M.min || M.min(p)));
    const ranked = valid.slice().sort((a, b) => (asc ? a[metric] - b[metric] : b[metric] - a[metric]) || a.s.localeCompare(b.s, "sk"));
    const rank = new Map<string, number>(); let prev: number | null = null, r = 0;
    ranked.forEach((p, i) => { if (p[metric] !== prev) { r = i + 1; prev = p[metric]; } rank.set(p.id, r); });
    const shown = ranked.filter((p) => (!club || p.c === club) && (!q || p.n.toLowerCase().normalize("NFD").replace(/\p{M}/gu, "").includes(q)));
    const vals = valid.map((p) => p[metric] as number); const max = Math.max(...vals, 0);
    // Shares crowd near 100 %: start the scale at the lowest value (rounded down to 10 %) so differences show.
    const share = metric === "att" || metric === "loy";
    const p10 = vals.slice().sort((a, b) => a - b)[Math.floor(vals.length * 0.1)] ?? 0;
    const lo = share ? Math.max(0, Math.floor(p10 * 20) / 20 - 0.05) : 0, hi = share ? 1 : max;
    const avgAll = vals.reduce((a, b) => a + b, 0) / (vals.length || 1);
    const sel = shown.map((p) => p[metric] as number); const avgSel = sel.reduce((a, b) => a + b, 0) / (sel.length || 1);
    $("lb-sum").innerHTML = `<span><i class="avgmark" aria-hidden="true"></i>Priemer snemovne <b>${M.f(avgAll, {})}</b></span>${club ? `<span>Priemer klubu ${esc(club)} <b>${M.f(avgSel, {})}</b></span>` : ""}${share && lo > 0 ? `<span>Stupnica pruhov začína na ${pc(lo)}</span>` : ""}<span>${shown.length} ${shown.length === 1 ? "poslanec" : shown.length < 5 ? "poslanci" : "poslancov"}</span>`;
    const limit = all || q || club ? shown.length : 25;
    $("lb").innerHTML = shown.slice(0, limit).map((p) => {
      const w = hi > lo ? ((p[metric] - lo) / (hi - lo)) * 100 : 0;
      return `<li><a href="/poslanci/${p.id}/" style="--club:${p.col}">
        <span class="rk">${rank.get(p.id)}.</span>
        <span class="ava${p.p ? " img" : ""}" aria-hidden="true">${p.p ? `<img src="${p.p}" alt="" loading="lazy" width="40" height="40">` : esc(p.i)}</span>
        <span class="who"><b>${esc(p.n)}</b><small>${esc(p.c)}</small></span>
        <span class="bar" aria-hidden="true"><i style="width:${Math.max(1.5, w)}%"></i><em style="left:${hi > lo ? ((avgAll - lo) / (hi - lo)) * 100 : 0}%"></em></span>
        <span class="val">${M.f(p[metric], p)}</span></a></li>`;
    }).join("") || `<li class="empty">Nikto nezodpovedá výberu.</li>`;
    $("lb-more").hidden = limit >= shown.length;
    $("lb-more").textContent = `Zobraziť všetkých ${shown.length}`;
  }
  $("metrics").addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest("[data-k]") as HTMLElement | null; if (!b) return; metric = b.dataset.k!; asc = !!METRICS.find((m) => m.k === metric)!.asc; all = false; lb(); tab("rebricky"); });
  $("clubchips").addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest("[data-c]") as HTMLElement | null; if (!b) return; club = b.dataset.c!; lb(); });
  $("ord-desc").addEventListener("click", () => { asc = false; lb(); });
  $("ord-asc").addEventListener("click", () => { asc = true; lb(); });
  $("lb-q").addEventListener("input", (e) => { q = (e.target as HTMLInputElement).value.trim().toLowerCase().normalize("NFD").replace(/\p{M}/gu, ""); lb(); });
  $("lb-more").addEventListener("click", () => { all = true; lb(); });

  /* ---------- clubs ---------- */
  const CM = [
    { k: "coh", l: "Súdržnosť", d: "Ako jednotne hlasujú poslanci klubu (100 % = všetci rovnako).", f: pc },
    { k: "att", l: "Účasť", d: "Priemerná účasť poslancov klubu na hlasovaniach.", f: pc },
    { k: "seats", l: "Počet poslancov", d: "Aktuálny počet členov klubu.", f: (v: number) => nf(v) },
    { k: "talk", l: "Čas v rozprave na poslanca", d: "Priemerný čas pri rečníckom pulte na jedného poslanca klubu.", f: dur },
    { k: "reb", l: "Hlasovania proti klubu", d: "Súčet hlasovaní, v ktorých členovia hlasovali inak ako väčšina klubu.", f: (v: number) => nf(v) },
    ...(D.hasExtra ? [{ k: "bills", l: "Návrhy zákonov", d: "Súčet návrhov, ktoré členovia klubu predložili alebo spolupredložili (spoločné návrhy sa rátajú každému).", f: (v: number) => nf(v) },
      { k: "interp", l: "Interpelácie", d: "Súčet interpelácií členov klubu.", f: (v: number) => nf(v) }] : []),
  ];
  let cm = "coh", agrClub = D.clubs.find((c) => c.agr)?.c ?? "";
  $("cmetrics").innerHTML = CM.map((m) => `<button type="button" role="radio" data-k="${m.k}">${m.l}</button>`).join("");
  $("agrchips").innerHTML = D.clubs.filter((c) => c.agr).map((c) => `<button type="button" data-c="${esc(c.c)}" style="--club:${c.col}"><i></i>${esc(c.c)}</button>`).join("");
  const bars = (rows: { label: string; col: string; v: number | null; txt: string }[], max: number) => rows.map((r) =>
    `<div class="cb" style="--club:${r.col}"><span class="cl"><i></i>${esc(r.label)}</span><span class="bar"><i style="width:${r.v == null ? 0 : Math.max(1.5, (r.v / max) * 100)}%"></i></span><span class="val">${r.txt}</span></div>`).join("");
  function clubsView() {
    const M = CM.find((m) => m.k === cm)!;
    for (const b of $("cmetrics").querySelectorAll("button")) b.setAttribute("aria-checked", String(b.dataset.k === cm));
    $("c-desc").textContent = M.d;
    const rows = D.clubs.filter((c) => c[cm] != null).sort((a, b) => b[cm] - a[cm]);
    $("cbars").innerHTML = bars(rows.map((c) => ({ label: c.c, col: c.col, v: c[cm], txt: M.f(c[cm]) })), cm === "coh" || cm === "att" ? 1 : Math.max(...rows.map((c) => c[cm])));
    for (const b of $("agrchips").querySelectorAll("button")) b.setAttribute("aria-pressed", String(b.dataset.c === agrClub));
    const me = D.clubs.find((c) => c.c === agrClub);
    if (me?.agr) {
      const r = Object.entries(me.agr as Record<string, number | null>).sort((a, b) => (b[1] ?? 0) - (a[1] ?? 0));
      $("agrbars").innerHTML = bars(r.map(([c, v]) => ({ label: c, col: D.clubs.find((x) => x.c === c)?.col ?? "var(--line-2)", v, txt: pc(v) })), 1);
    }
  }
  $("cmetrics").addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest("[data-k]") as HTMLElement | null; if (b) { cm = b.dataset.k!; clubsView(); } });
  $("agrchips").addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest("[data-c]") as HTMLElement | null; if (b) { agrClub = b.dataset.c!; clubsView(); } });

  /* ---------- over time ---------- */
  const MONTHS = ["jan", "feb", "mar", "apr", "máj", "jún", "júl", "aug", "sep", "okt", "nov", "dec"];
  const mname = (k: string) => `${MONTHS[Number(k.slice(5, 7)) - 1]} ${k.slice(2, 4)}`;
  const TM = [
    { k: "n", l: "Počet hlasovaní", d: "Koľkokrát sa v mesiaci hlasovalo.", f: (v: number) => `${nf(v)} hlasovaní`, max: 0 },
    { k: "att", l: "Účasť", d: "Priemerná účasť poslancov na hlasovaniach v mesiaci.", f: pc, max: 1 },
    { k: "ok", l: "Podiel schválených", d: "Podiel hlasovaní v mesiaci, ktoré prešli.", f: pc, max: 1 },
    { k: "talk", l: "Čas rozpravy", d: "Súčet času vystúpení v rozprave v mesiaci (v hodinách).", f: (v: number) => `${nf(v, 0)} h`, max: 0 },
  ];
  let tm = "n", tsel = D.months.length - 1;
  $("tmetrics").innerHTML = TM.map((m) => `<button type="button" role="radio" data-k="${m.k}">${m.l}</button>`).join("");
  function timeView() {
    const M = TM.find((m) => m.k === tm)!;
    for (const b of $("tmetrics").querySelectorAll("button")) b.setAttribute("aria-checked", String(b.dataset.k === tm));
    $("t-desc").textContent = M.d;
    const max = M.max || Math.max(...D.months.map((x) => x[tm]), 1);
    $("tchart").innerHTML = D.months.map((x, i) => `<button type="button" class="tc${i === tsel ? " sel" : ""}" data-i="${i}" aria-label="${mname(x.m)}: ${M.f(x[tm])}" aria-pressed="${i === tsel}">
      <span class="tip">${mname(x.m)}<b>${M.f(x[tm])}</b></span><i style="height:${Math.max(1, (x[tm] / max) * 100)}%"></i></button>`).join("");
    const ys = [...new Set(D.months.map((x) => x.m.slice(0, 4)))];
    $("taxis").innerHTML = D.months.map((x, i) => `<span>${x.m.endsWith("-01") || i === 0 ? x.m.slice(0, 4) : ""}</span>`).join("");
    void ys;
    const x = D.months[tsel];
    if (x) $("tinfo").innerHTML = `<b>${mname(x.m).replace(/^./, (c) => c.toUpperCase())}</b>
      <span>${nf(x.n)} hlasovaní</span><span>účasť ${pc(x.att)}</span><span>schválených ${pc(x.ok)}</span><span>${nf(x.talk, 0)} h rozpravy</span>
      <a href="/schodze/#d=${x.d}">Otvoriť v kalendári schôdzí</a>`;
  }
  $("tmetrics").addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest("[data-k]") as HTMLElement | null; if (b) { tm = b.dataset.k!; timeView(); } });
  $("tchart").addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest("[data-i]") as HTMLElement | null; if (b) { tsel = Number(b.dataset.i); timeView(); } });
  $("tchart").addEventListener("keydown", (e) => {
    const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0; if (!d) return;
    e.preventDefault(); tsel = Math.min(D.months.length - 1, Math.max(0, tsel + d)); timeView(); ($("tchart").querySelector(`[data-i="${tsel}"]`) as HTMLElement).focus();
  });

  /* ---------- start ---------- */
  const h = location.hash.slice(1); const [ht, hm] = h.split("-");
  if (ht === "rebricky" && METRICS.some((m) => m.k === hm)) metric = hm;
  lb(); clubsView(); timeView(); tab(tabs.includes(ht) ? ht : "rebricky", false);
  // keep the URL shareable for the chosen metric
  $("metrics").addEventListener("click", () => history.replaceState(null, "", `#rebricky-${metric}`));
</script>

