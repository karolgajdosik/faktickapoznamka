---
// Search: instant matches for MPs, prints and committees (local data), then full-text results
// from the Pagefind index grouped by kind (transcripts, laws, MPs, sessions, committees).
import Base from "../layouts/Base.astro";
const ideas = ["rozpočet", "zdravotníctvo", "konsolidácia", "Trestný zákon", "RTVS", "dane", "školstvo", "energie"];
---
<Base title="Hľadať" description="Vyhľadávanie v prepisoch rozpravy, zákonoch, poslancoch, schôdzach a výboroch NR SR.">
  <section class="sx-hero">
    <h1>Hľadať v parlamente</h1>
    <p class="meta-line">Prepisy rozpravy, zákony, poslanci, schôdze a výbory na jednom mieste.</p>
    <form class="sx-box" id="sx-form" role="search" action="/hladat/" method="get">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <label class="sr-only" for="sx-q">Hľadať</label>
      <input id="sx-q" name="q" type="search" placeholder="Slovo, meno poslanca alebo číslo tlače" autocomplete="off" enterkeyhint="search" autofocus />
      <kbd class="sx-kbd" aria-hidden="true">/</kbd>
      <button type="button" class="sx-clear" id="sx-clear" aria-label="Vymazať" hidden>✕</button>
    </form>
    <div class="sx-ideas" id="sx-ideas">
      <div id="sx-recent-wrap" hidden><span class="fx-label">Naposledy</span><span id="sx-recent"></span></div>
      <div><span class="fx-label">Skúste</span>{ideas.map((x) => <button type="button" class="fx-chip" data-q={x}>{x}</button>)}</div>
    </div>
  </section>

  <nav class="sx-browse" id="sx-browse" aria-label="Prehliadať">
    {[["/poslanci/", "Poslanci", "150 profilov, účasť a hlasovanie"], ["/zakony/", "Zákony", "Tlače, čítania a stav"], ["/hlasovania/", "Hlasovania", "Všetky hlasovania s filtrom"],
      ["/schodze/", "Schôdze", "Kalendár a program"], ["/vybory/", "Výbory", "Zloženie a predsedovia"], ["/majetok/", "Majetok", "Príjmy a priznania"]].map(([h, t, d]) => (
      <a href={h}><b>{t}</b><span>{d}</span></a>
    ))}
  </nav>

  <div class="sx-layout" id="sx-layout" hidden>
    <aside class="sx-side">
      <div class="sx-tabs" id="sx-tabs" role="tablist" aria-label="Druh výsledkov" aria-orientation="vertical"></div>
    </aside>
    <div class="sx-main-col">
      <section class="sx-quick" id="sx-quick" hidden aria-label="Rýchle výsledky"></section>
      <p class="sx-status" id="sx-status" aria-live="polite"></p>
      <ol class="sx-results" id="sx-results"></ol>
      <button type="button" class="fx-more" id="sx-more" hidden>Zobraziť ďalšie</button>
    </div>
  </div>
</Base>

<script>
  type Mp = { id: string; n: string; c: string; col: string; p: string | null; i: string };
  let L: { mps: Mp[]; laws: [string, string, string][]; com: [number, string][] } = { mps: [], laws: [], com: [] };
  const local = fetch("/hladat/data.json").then((r) => r.json()).then((d) => { L = d; quick(input.value); });
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const norm = (s: string) => s.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();
  const input = $("sx-q") as HTMLInputElement;

  const KINDS: Record<string, string> = { rozprava: "Rozprava", zakony: "Zákony", poslanci: "Poslanci", schodze: "Schôdze", vybory: "Výbory" };
  const kindOf = (url: string) => url.split("/")[1] ?? "";

  /* recent searches (this browser only) */
  const recent = (() => { try { return JSON.parse(localStorage.getItem("fp-recent") ?? "[]") as string[]; } catch { return []; } })();
  const remember = (q: string) => { const r = [q, ...recent.filter((x) => x !== q)].slice(0, 6); try { localStorage.setItem("fp-recent", JSON.stringify(r)); } catch {} };
  function drawRecent() {
    $("sx-recent-wrap").hidden = !recent.length;
    $("sx-recent").innerHTML = recent.map((x) => `<button type="button" class="fx-chip" data-q="${esc(x)}">${esc(x)}</button>`).join("");
  }

  /* instant local matches */
  function quick(q: string) {
    const n = norm(q).trim(); if (!n) { $("sx-quick").hidden = true; return; }
    const parts = n.split(/\s+/);
    const mps = L.mps.filter((m) => { const w = norm(m.n); return parts.every((p) => w.split(/\s+/).some((x) => x.startsWith(p))); }).slice(0, 6);
    const num = n.match(/^(?:tl(?:ac)?\.?\s*)?(\d{1,4})$/);
    const tl = num ? L.laws.filter((l) => l[0] === num[1]) : [];
    const com = n.length >= 3 ? L.com.filter((c) => norm(c[1]).includes(n)).slice(0, 3) : [];
    const html = [
      mps.length ? `<div class="sx-group"><h2>Poslanci</h2><div class="sx-mps">${mps.map((m) => `<a href="/poslanci/${m.id}/" style="--club:${m.col}"><span class="ava${m.p ? " img" : ""}" aria-hidden="true">${m.p ? `<img src="${m.p}" alt="" width="48" height="48">` : esc(m.i)}</span><span><b>${esc(m.n)}</b><small>${esc(m.c)}</small></span></a>`).join("")}</div></div>` : "",
      tl.length ? `<div class="sx-group"><h2>Tlač</h2>${tl.map((l) => `<a class="sx-law" href="/zakony/${l[0]}/"><b>tlač ${l[0]}</b><span>${esc(l[1])}</span><span class="pill ${l[2] === "schválený" ? "yes" : l[2] === "neschválený" ? "no" : ""}">${l[2]}</span></a>`).join("")}</div>` : "",
      com.length ? `<div class="sx-group"><h2>Výbory</h2>${com.map((c) => `<a class="sx-law" href="/vybory/${c[0]}/"><b>výbor</b><span>${esc(c[1])}</span></a>`).join("")}</div>` : "",
    ].join("");
    $("sx-quick").innerHTML = html; $("sx-quick").hidden = !html;
  }

  /* full text via Pagefind */
  let pf: any = null, all: { url: string; title: string; excerpt: string; kind: string; subs: { url: string; title: string; excerpt: string }[] }[] = [], raw: any[] = [];
  let tab = "", shown = 0, seq = 0;
  const PAGE = 12;
  async function load() {
    if (pf) return pf;
    try { pf = await import(/* @vite-ignore */ "/pagefind/pagefind.js"); await pf.options({ excerptLength: 26 }); pf.init(); } catch { pf = false; }
    return pf;
  }
  async function full(q: string) {
    const my = ++seq;
    if (!q.trim()) { $("sx-results").innerHTML = ""; $("sx-status").textContent = ""; $("sx-more").hidden = true; return; }
    const p = await load();
    if (!p) { $("sx-status").textContent = "Fulltextové vyhľadávanie je dostupné na zverejnenej stránke."; return; }
    $("sx-status").textContent = "Hľadám…";
    const r = await p.debouncedSearch(q, {}, 180); if (!r || my !== seq) return;
    raw = r.results; all = [];
    const first = await Promise.all(raw.slice(0, 80).map((x: any) => x.data()));
    if (my !== seq) return;
    const label = (d: any) => {
      const m = d.url.match(/^\/rozprava\/(\d+)\/(\d{4})-(\d{2})-(\d{2})\//);
      if (m) return `Rozprava ${new Date(+m[2], +m[3] - 1, +m[4]).toLocaleDateString("sk-SK", { weekday: "long", day: "numeric", month: "long", year: "numeric" })}, ${m[1]}. schôdza`;
      return d.meta?.title?.replace(/ – faktická poznámka$| \| faktická poznámka$/, "") ?? d.url;
    };
    all = first.map((d: any) => ({ url: d.url, title: label(d), excerpt: d.excerpt, kind: kindOf(d.url),
      subs: (d.sub_results ?? []).filter((s: any) => s.url !== d.url).slice(0, 3).map((s: any) => ({ url: s.url, title: s.title, excerpt: s.excerpt })) }));
    const counts = new Map<string, number>(); for (const x of all) counts.set(x.kind, (counts.get(x.kind) ?? 0) + 1);
    if (tab && !counts.get(tab)) tab = "";
    $("sx-tabs").hidden = false;
    $("sx-tabs").innerHTML = [["", "Všetko", all.length] as [string, string, number], ...Object.entries(KINDS).filter(([k]) => counts.get(k)).map(([k, l]) => [k, l, counts.get(k)!] as [string, string, number])]
      .map(([k, l, n]) => `<button role="tab" class="fx-chip" data-tab="${k}" aria-selected="${tab === k}" aria-pressed="${tab === k}">${l}<span class="n">${n}${k === "" && raw.length > all.length ? "+" : ""}</span></button>`).join("");
    const total = raw.length;
    $("sx-status").innerHTML = total ? `${total.toLocaleString("sk-SK")} ${total === 1 ? "stránka" : total < 5 ? "stránky" : "stránok"} pre „${esc(q)}“ · <a href="/hlasovania/?q=${encodeURIComponent(q)}">hľadať aj v hlasovaniach</a>` : `Pre „${esc(q)}“ sme nič nenašli. Skúste iné slovo alebo <a href="/hlasovania/?q=${encodeURIComponent(q)}">hľadať v hlasovaniach</a>.`;
    shown = 0; $("sx-results").innerHTML = ""; draw();
  }
  function draw() {
    const list = all.filter((x) => !tab || x.kind === tab);
    const chunk = list.slice(shown, shown + PAGE);
    $("sx-results").insertAdjacentHTML("beforeend", chunk.map((x) => `<li class="sx-r k-${x.kind}">
      <a href="${x.url}" class="sx-main"><span class="sx-kind">${KINDS[x.kind] ?? "Stránka"}</span><b>${esc(x.title)}</b><span class="sx-ex">${x.excerpt}</span></a>
      ${x.subs.length ? `<ul class="sx-subs">${x.subs.map((s) => `<li><a href="${s.url}"><b>${esc(s.title)}</b><span class="sx-ex">${s.excerpt}</span></a></li>`).join("")}</ul>` : ""}</li>`).join(""));
    shown += chunk.length;
    $("sx-more").hidden = shown >= list.length;
  }

  /* wiring */
  let t: number | undefined;
  function go(q: string, push = true) {
    input.value = q; $("sx-clear").hidden = !q; $("sx-ideas").hidden = !!q; $("sx-browse").hidden = !!q; $("sx-layout").hidden = !q;
    quick(q); full(q);
    if (push) history.replaceState(null, "", q ? `?q=${encodeURIComponent(q)}` : location.pathname);
  }
  input.addEventListener("input", () => { clearTimeout(t); const q = input.value; $("sx-clear").hidden = !q; $("sx-layout").hidden = !q; $("sx-browse").hidden = !!q; $("sx-ideas").hidden = !!q; quick(q); t = window.setTimeout(() => go(q), 200); });
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") { e.preventDefault(); const q = input.value.trim(); if (q) remember(q); go(q); }
    if (e.key === "ArrowDown") { e.preventDefault(); (document.querySelector("#sx-quick a, #sx-results a") as HTMLElement | null)?.focus(); }
  });
  $("sx-form").addEventListener("submit", (e) => e.preventDefault());
  $("sx-clear").addEventListener("click", () => { go(""); drawRecent(); input.focus(); });
  $("sx-ideas").addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest("[data-q]") as HTMLElement | null; if (b) { remember(b.dataset.q!); go(b.dataset.q!); } });
  $("sx-tabs").addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest("[data-tab]") as HTMLElement | null; if (!b) return; tab = b.dataset.tab!; for (const x of $("sx-tabs").querySelectorAll("button")) { x.setAttribute("aria-selected", String(x === b)); x.setAttribute("aria-pressed", String(x === b)); } shown = 0; $("sx-results").innerHTML = ""; draw(); });
  $("sx-more").addEventListener("click", draw);
  document.addEventListener("click", (e) => { const a = (e.target as HTMLElement).closest("#sx-results a, #sx-quick a"); if (a && input.value.trim()) remember(input.value.trim()); });
  document.addEventListener("keydown", (e) => { if (e.key === "/" && document.activeElement !== input && !(e.target as HTMLElement).matches("input, textarea")) { e.preventDefault(); input.focus(); input.select(); } });

  drawRecent();
  const q0 = new URLSearchParams(location.search).get("q") ?? "";
  if (q0) go(q0, false); else load();
</script>

<style>
  .sx-hero { padding: clamp(1rem, 5vw, 3.5rem) 0 .5rem; max-width: 46rem; margin: 0 auto; text-align: center; }
  .sx-hero .meta-line { margin-left: auto; margin-right: auto; }
  .sx-ideas > div { justify-content: center; }
  @media (max-width: 44rem) { .sx-hero { text-align: left; } .sx-ideas > div { justify-content: flex-start; } }
  .sx-browse { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: .6rem; max-width: 60rem; margin: 2.5rem auto 1rem; }
  .sx-browse a { display: grid; gap: .2rem; padding: 1rem 1.1rem; border-radius: 1rem; background: var(--panel); border: 1px solid var(--line); text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  .sx-browse a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .sx-browse span { color: var(--muted); font-size: var(--step--1); }
  .sx-browse[hidden], .sx-layout[hidden] { display: none; }
  .sx-layout { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 2rem; margin-top: 1.75rem; align-items: start; }
  .sx-side { position: sticky; top: 5rem; }
  .sx-side .sx-tabs { flex-direction: column; align-items: stretch; margin: 0; overflow: visible; }
  .sx-side .sx-tabs :global(.fx-chip) { justify-content: space-between; border-radius: .7rem; border-color: transparent; background: transparent; }
  .sx-side .sx-tabs :global(.fx-chip[aria-pressed="true"]) { background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--text); border-color: transparent; }
  .sx-side .sx-tabs :global(.fx-chip[aria-pressed="true"] .n) { color: var(--accent); }
  .sx-side .sx-tabs :global(.fx-chip:hover) { background: var(--panel); }
  .sx-main-col .sx-quick { margin-top: 0; }
  @media (max-width: 52rem) {
    .sx-layout { grid-template-columns: 1fr; gap: .5rem; }
    .sx-side { position: static; }
    .sx-side .sx-tabs { flex-direction: row; overflow-x: auto; }
    .sx-side .sx-tabs :global(.fx-chip) { border-color: var(--line-2); background: var(--panel); border-radius: 999px; }
  }
  .sx-hero h1 { margin-bottom: .3rem; }
  .sx-box { position: relative; text-align: left; display: flex; align-items: center; gap: .7rem; height: 3.6rem; margin-top: 1.25rem; padding: 0 .6rem 0 1.2rem; border-radius: 1.2rem; background: var(--panel); border: 1px solid var(--line-2);
    box-shadow: 0 18px 40px -26px rgba(0, 0, 0, .55); }
  .sx-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent), 0 18px 40px -26px rgba(0, 0, 0, .55); }
  .sx-box svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: var(--muted); stroke-width: 2; flex: none; }
  .sx-box input { all: unset; flex: 1; min-width: 0; font-size: 1.1rem; color: var(--text); }
  .sx-box input::placeholder { color: var(--faint); }
  .sx-box input::-webkit-search-cancel-button { display: none; }
  .sx-kbd { font: inherit; font-size: var(--step--2); color: var(--muted); border: 1px solid var(--line-2); border-radius: .35rem; padding: .05rem .45rem; }
  .sx-box:focus-within .sx-kbd { display: none; }
  @media (hover: none) { .sx-kbd { display: none; } }
  .sx-clear { all: unset; cursor: pointer; width: 2.2rem; height: 2.2rem; display: grid; place-items: center; border-radius: 50%; color: var(--muted); }
  .sx-clear:hover { background: var(--panel-2); color: var(--text); }
  .sx-ideas { display: grid; gap: .6rem; margin-top: 1rem; }
  .sx-ideas > div { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
  #sx-recent { display: contents; }
  .sx-quick { display: grid; gap: 1.1rem; margin: 1.5rem 0 .5rem; padding: 1rem 1.1rem; border-radius: 1rem; background: var(--panel); border: 1px solid var(--line); }
  .sx-quick :global(h2) { margin: 0 0 .5rem; font-size: var(--step--2); color: var(--muted); font-weight: 750; }
  .sx-quick :global(.sx-mps) { display: grid; gap: .45rem; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); }
  .sx-quick :global(.sx-mps a) { display: flex; align-items: center; gap: .65rem; padding: .45rem .6rem; border-radius: .8rem; border: 1px solid var(--line); text-decoration: none; color: inherit; }
  .sx-quick :global(.sx-mps a:hover), .sx-quick :global(.sx-mps a:focus-visible) { border-color: var(--club); background: color-mix(in srgb, var(--club) 8%, transparent); }
  .sx-quick :global(.sx-mps .ava) { --s: 2.6rem; }
  .sx-quick :global(.sx-mps span:last-child) { display: flex; flex-direction: column; line-height: 1.25; }
  .sx-quick :global(.sx-mps small) { color: var(--muted); font-size: var(--step--2); }
  .sx-quick :global(.sx-law) { display: grid; grid-template-columns: auto 1fr auto; gap: .75rem; align-items: center; padding: .55rem .2rem; text-decoration: none; color: inherit; font-size: var(--step--1); border-top: 1px solid var(--line); }
  .sx-quick :global(.sx-law b) { color: var(--accent); white-space: nowrap; }
  @media (max-width: 44rem) { .sx-quick :global(.sx-law) { grid-template-columns: 1fr auto; } .sx-quick :global(.sx-law > span:nth-child(2)) { grid-column: 1 / -1; grid-row: 2; } }
  .sx-tabs { display: flex; gap: .4rem; overflow-x: auto; scrollbar-width: none; margin: 1.5rem 0 .25rem; }
  .sx-status { color: var(--muted); font-size: var(--step--1); margin: .6rem 0 1rem; }
  .sx-results { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; }
  .sx-results :global(.sx-r) { border-radius: 1rem; background: var(--panel); border: 1px solid var(--line); overflow: hidden; }
  .sx-results :global(.sx-main) { display: grid; gap: .25rem; padding: .9rem 1.1rem; text-decoration: none; color: inherit; }
  .sx-results :global(.sx-main:hover b), .sx-results :global(.sx-main:focus-visible b) { color: var(--accent); }
  .sx-results :global(.sx-kind) { font-size: var(--step--2); font-weight: 750; color: var(--muted); }
  .sx-results :global(.k-rozprava .sx-kind) { color: var(--accent); }
  .sx-results :global(.k-zakony .sx-kind) { color: var(--za); }
  .sx-results :global(.sx-ex) { color: var(--muted); font-size: var(--step--1); line-height: 1.5; }
  .sx-results :global(mark) { background: color-mix(in srgb, var(--accent) 22%, transparent); color: var(--text); border-radius: 3px; padding: 0 .1em; }
  .sx-results :global(.sx-subs) { list-style: none; margin: 0; padding: 0 1.1rem .6rem; display: grid; }
  .sx-results :global(.sx-subs a) { display: grid; gap: .1rem; padding: .55rem 0 .55rem .9rem; border-left: 2px solid var(--line-2); text-decoration: none; color: inherit; font-size: var(--step--1); }
  .sx-results :global(.sx-subs a:hover) { border-left-color: var(--accent); }
  .sx-results :global(.sx-subs b) { font-weight: 650; }
</style>
