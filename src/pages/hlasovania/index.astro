---
import { safeJson } from "../../lib/safejson";
import Base from "../../layouts/Base.astro";
import VoteList from "../../components/VoteList.astro";
import { votes, sessions } from "../../lib/data";
const recent = votes.slice(0, 40);
const years = [...new Set(votes.map((v) => v.datetime.slice(0, 4)))].sort().reverse();
---
<Base title="Hlasovania" description="Všetky hlasovania Národnej rady SR s filtrom podľa typu, výsledku, obdobia, schôdze a toho, ako hlasoval klub.">
  <h1>Hlasovania</h1>
  <p class="meta-line">Všetkých {votes.length.toLocaleString("sk-SK")} hlasovaní IX. volebného obdobia. Filtrujte podľa typu, výsledku, obdobia alebo toho, ako hlasoval klub.</p>

  <form class="fx" id="fx" role="search" onsubmit="return false">
    <label class="fx-search">
      <span class="sr-only">Hľadať v hlasovaniach</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder="Hľadať: „rozpočet“, „tlač 1448“, „40. schôdza“" autocomplete="off" enterkeyhint="search" />
      <button type="button" class="fx-clear" id="q-clear" aria-label="Vymazať" hidden>✕</button>
    </label>
    <div class="fx-row fx-wrap" id="f-kind" role="group" aria-label="Typ hlasovania"></div>
    <div class="fx-row fx-wrap">
      <span class="fx-label">Výsledok</span>
      <span id="f-res" role="group" aria-label="Výsledok" style="display:contents"></span>
      <span class="fx-label" style="margin-left:.6rem">Obdobie</span>
      <span id="f-when" role="group" aria-label="Obdobie" style="display:contents"></span>
      <select class="fx-sel" id="f-session" aria-label="Schôdza"><option value="">Každá schôdza</option>{sessions.slice().sort((a, b) => b.n - a.n).map((s) => <option value={s.n}>{s.n}. schôdza</option>)}</select>
    </div>
    <div class="fx-row fx-wrap">
      <span class="fx-label">Klub hlasoval</span>
      <select class="fx-sel" id="f-club" aria-label="Klub"><option value="">vyberte klub</option></select>
      <span id="f-pos" role="group" aria-label="Ako hlasoval" style="display:contents"></span>
      <select class="fx-sel" id="f-club2" aria-label="Porovnať s klubom" hidden><option value="">a iný klub…</option></select>
      <span id="f-pos2" role="group" aria-label="Ako hlasoval druhý klub" style="display:contents"></span>
    </div>
  </form>

  <div class="fx-bar" aria-live="polite">
    <span class="fx-count" id="count">{votes.length.toLocaleString("sk-SK")} <small>hlasovaní</small></span>
    <span class="fx-active" id="active"></span>
    <select class="fx-sel fx-sort" id="sort" aria-label="Zoradiť">
      <option value="new">Najnovšie</option><option value="old">Najstaršie</option><option value="close">Najtesnejšie</option><option value="att">Najnižšia účasť</option>
    </select>
  </div>
  <div id="vlbox"><VoteList items={recent} /></div>
  <button type="button" class="fx-more" id="more" hidden>Načítať ďalšie</button>
  <script type="application/json" id="years" set:html={safeJson(years)} />
</Base>

<script>
  type Row = [string, string, string, string, string, number, number, number, number, number, number, number, string, string];
  document.querySelector("#vlbox ul.votes")!.id = "vl";
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const norm = (s: string) => s.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();
  // Slovak is inflected (rozpočet, rozpočte, rozpočtu): match word starts and drop the ending of longer words.
  const stem = (w: string) => (w.length >= 6 ? w.slice(0, -2) : w.length === 5 ? w.slice(0, -1) : w);
  const words = (s: string) => " " + norm(s).replace(/[^\p{L}\p{N}]+/gu, " ");
  const nf = (n: number) => n.toLocaleString("sk-SK");
  const plural = (n: number) => (n === 1 ? "hlasovanie" : n >= 2 && n <= 4 ? "hlasovania" : "hlasovaní");
  const years = JSON.parse($("years").textContent!) as string[];

  const KINDS: [string, string][] = [["", "Všetky"], ["f", "Záverečné o zákonoch"], ["a", "Pozmeňujúce návrhy"], ["close", "Tesné"], ["o", "Voľby a dôvera"], ["p", "Procedurálne"], ["x", "Ostatné"]];
  const RES: [string, string][] = [["", "Všetky"], ["1", "Schválené"], ["0", "Neschválené"]];
  const WHEN: [string, string][] = [["", "Kedykoľvek"], ["7", "7 dní"], ["30", "30 dní"], ...years.map((y) => [`y${y}`, y] as [string, string])];
  const POS: [string, string][] = [["Z", "za"], ["P", "proti"], ["?", "zdržal sa"]];

  const S = { q: "", kind: "", res: "", when: "", session: "", club: "", pos: "", club2: "", pos2: "", sort: "new" };
  const fromUrl = () => { const u = new URLSearchParams(location.search); for (const k of Object.keys(S) as (keyof typeof S)[]) if (u.has(k)) S[k] = u.get(k)!; };
  const toUrl = () => { const u = new URLSearchParams(); for (const [k, v] of Object.entries(S)) if (v && !(k === "sort" && v === "new")) u.set(k, v); history.replaceState(null, "", `${location.pathname}${u.size ? `?${u}` : ""}`); };

  let rows: Row[] = [], clubs: string[] = [], search: string[] = [], shown = 0, list: Row[] = [];
  const PAGE = 60;
  const margin = (r: Row) => { const present = r[7] + r[8] + r[9] + r[10]; return Math.abs(r[7] - Math.floor(present / 2) - 1); };
  const now = Date.now();

  function match(r: Row, i: number, skip?: string) {
    if (S.q) {
      const q = norm(S.q);
      const tl = q.match(/^(?:tl(?:ac)?\.?\s*)?(\d{1,4})$/), se = q.match(/^(\d{1,3})\.?\s*schodz/);
      if (se) { if (r[5] !== Number(se[1])) return false; }
      else if (tl) { if (r[4] !== tl[1] && r[0] !== tl[1]) return false; }
      else if (!q.split(/\s+/).map(stem).every((w) => search[i].includes(" " + w))) return false;
    }
    if (skip !== "kind" && S.kind) { if (S.kind === "close" ? !(r[6] !== -1 && margin(r) <= 5) : r[12] !== S.kind) return false; }
    if (skip !== "res" && S.res && String(r[6]) !== S.res) return false;
    if (skip !== "when" && S.when) { if (S.when.startsWith("y") ? !r[1].startsWith(S.when.slice(1)) : now - Date.parse(r[1]) > Number(S.when) * 864e5) return false; }
    if (S.session && String(r[5]) !== S.session) return false;
    if (S.club && S.pos) { const i1 = clubs.indexOf(S.club); if (i1 < 0 || r[13][i1] !== S.pos) return false; }
    if (S.club2 && S.pos2) { const i2 = clubs.indexOf(S.club2); if (i2 < 0 || r[13][i2] !== S.pos2) return false; }
    return true;
  }

  function chips(el: HTMLElement, opts: [string, string][], key: "kind" | "res" | "when" | "pos" | "pos2", counts?: Map<string, number>) {
    el.innerHTML = opts.map(([v, l]) => {
      const n = counts?.get(v);
      const cls = key === "res" ? (v === "1" ? " yes" : v === "0" ? " no" : "") : "";
      return `<button type="button" class="fx-chip${cls}" data-v="${esc(v)}" aria-pressed="${S[key] === v}" ${n === 0 && S[key] !== v ? "disabled" : ""}>${esc(l)}${n !== undefined ? `<span class="n">${nf(n)}</span>` : ""}</button>`;
    }).join("");
  }

  function facet(key: "kind" | "res" | "when", opts: [string, string][]) {
    const m = new Map<string, number>(opts.map(([v]) => [v, 0]));
    rows.forEach((r, i) => {
      if (!match(r, i, key)) return;
      m.set("", m.get("")! + 1);
      if (key === "kind") { m.set(r[12], (m.get(r[12]) ?? 0) + 1); if (r[6] !== -1 && margin(r) <= 5) m.set("close", m.get("close")! + 1); }
      else if (key === "res") m.set(String(r[6]), (m.get(String(r[6])) ?? 0) + 1);
    });
    return m;
  }

  function row(r: Row) {
    let [id, dt, head, ctx, tlac, , passed, Z, P, Q, N, O] = r;
    // "Hlasovanie v treťom čítaní" says little on its own: lead with the law, keep the stage as context.
    if (ctx && /^Hlasovanie v \S+ čítaní$/.test(head)) [head, ctx] = [ctx, `${({ prvom: 1, druhom: 2, treťom: 3 } as Record<string, number>)[head.split(" ")[2]] ?? ""}. čítanie`];
    const tot = Z + P + Q + N + O || 1;
    const seg = ([["Z", Z], ["P", P], ["Q", Q], ["N", N], ["O", O]] as [string, number][]).filter(([, n]) => n > 0).map(([c, n]) => `<span class="v-${c}" style="flex-grow:${n / tot}"></span>`).join("");
    const time = new Date(dt).toLocaleTimeString("sk-SK", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Bratislava" });
    return `<li><time datetime="${dt}">${time}</time><span class="t"><a href="/hlasovania/${id}/">${esc(head)}</a>${ctx ? `<small class="ctx">${tlac ? `<a href="/zakony/${tlac}/">${esc(ctx)}${/čítanie$/.test(ctx) ? `, tlač ${tlac}` : ""}</a>` : esc(ctx)}</small>` : ""}</span>
      <span class="bar" role="img" aria-label="Za ${Z}, proti ${P}, zdržal sa ${Q}, nehlasoval ${N}, neprítomný ${O}">${seg}</span>
      <span class="res"><span class="pill ${passed === 1 ? "yes" : passed === 0 ? "no" : ""}">${passed === 1 ? "Schválené" : passed === 0 ? "Neschválené" : "Bez výsledku"}</span>${S.sort === "close" && passed !== -1 ? `<small class="mg">rozdiel ${margin(r) + 1}</small>` : ""}</span></li>`;
  }

  function render(reset = true) {
    if (reset) {
      list = rows.filter((r, i) => match(r, i));
      if (S.sort === "old") list.reverse();
      else if (S.sort === "close") list = list.filter((r) => r[6] !== -1).sort((a, b) => margin(a) - margin(b) || b[1].localeCompare(a[1]));
      else if (S.sort === "att") list.sort((a, b) => b[11] - a[11]);
      shown = 0; $("vl").innerHTML = "";
    }
    const chunk = list.slice(shown, shown + PAGE); let html = "";
    let prevDay = shown ? list[shown - 1][1].slice(0, 10) : "";
    const groupByDay = S.sort === "new" || S.sort === "old";
    let runTl = "", runN = 0, runId = 0;
    const flush = () => { if (runN > 0) html += `<li class="fx-run"><button type="button" data-run="${runId}">+ ${runN} ${runN === 1 ? "ďalšie hlasovanie" : runN < 5 ? "ďalšie hlasovania" : "ďalších hlasovaní"} k tlači ${runTl}</button></li>`; runN = 0; };
    for (const r of chunk) {
      const d = new Date(r[1]).toLocaleDateString("sv-SE", { timeZone: "Europe/Bratislava" });
      if (groupByDay && d !== prevDay) {
        const label = new Date(r[1]).toLocaleDateString("sk-SK", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Bratislava" });
        html += `<li class="fx-day"><span>${label.replace(/^./, (c) => c.toUpperCase())}</span>${r[5] ? `<a href="/schodze/${r[5]}/">${r[5]}. schôdza</a>` : ""}</li>`; prevDay = d;
      }
      const sameRun = groupByDay && r[4] && r[4] === runTl && d === prevDay;
      if (!sameRun) { flush(); runTl = groupByDay ? r[4] : ""; runId = Math.random(); html += groupByDay ? row(r) : row(r).replace(/<time[^>]*>[^<]*<\/time>/, `<time datetime="${r[1]}">${new Date(r[1]).toLocaleDateString("sk-SK", { day: "numeric", month: "numeric", year: "numeric", timeZone: "Europe/Bratislava" })}</time>`); continue; }
      runN++; html += row(r).replace("<li>", `<li hidden data-in="${runId}">`); continue;
      html += groupByDay ? row(r) : row(r).replace(/<time[^>]*>[^<]*<\/time>/, `<time datetime="${r[1]}">${new Date(r[1]).toLocaleDateString("sk-SK", { day: "numeric", month: "numeric", year: "numeric", timeZone: "Europe/Bratislava" })}</time>`);
    }
    flush();
    $("vl").insertAdjacentHTML("beforeend", html);
    shown += chunk.length;
    if (!list.length) $("vl").innerHTML = `<li class="fx-empty"><b>Nič sa nenašlo</b>Skúste zmeniť alebo zrušiť niektorý filter.</li>`;
    $("more").hidden = shown >= list.length;
    $("more").textContent = `Načítať ďalšie (${nf(list.length - shown)})`;
    if (reset) ui();
  }

  function ui() {
    chips($("f-kind"), KINDS, "kind", facet("kind", KINDS));
    chips($("f-res"), RES, "res", facet("res", RES));
    chips($("f-when"), WHEN, "when");
    chips($("f-pos"), POS, "pos"); for (const b of $("f-pos").querySelectorAll("button")) (b as HTMLButtonElement).disabled = !S.club;
    ($("f-club2") as HTMLSelectElement).hidden = !(S.club && S.pos);
    chips($("f-pos2"), S.club2 ? POS : [], "pos2");
    for (const id of ["f-session", "f-club", "f-club2", "sort"]) { const el = $(id) as HTMLSelectElement; const k = ({ "f-session": "session", "f-club": "club", "f-club2": "club2", sort: "sort" } as const)[id as "sort"]; el.value = S[k]; el.classList.toggle("on", !!S[k] && k !== "sort"); }
    ($("q") as HTMLInputElement).value !== S.q && (($("q") as HTMLInputElement).value = S.q);
    $("q-clear").hidden = !S.q;
    $("count").innerHTML = `${nf(list.length)} <small>${plural(list.length)}</small>`;
    const tags: [string, string][] = [];
    if (S.q) tags.push(["q", `„${S.q}“`]);
    if (S.kind) tags.push(["kind", KINDS.find((k) => k[0] === S.kind)![1]]);
    if (S.res) tags.push(["res", RES.find((k) => k[0] === S.res)![1]]);
    if (S.when) tags.push(["when", WHEN.find((k) => k[0] === S.when)?.[1] ?? S.when]);
    if (S.session) tags.push(["session", `${S.session}. schôdza`]);
    if (S.club && S.pos) tags.push(["club", `${S.club} ${POS.find((p) => p[0] === S.pos)![1]}`]);
    if (S.club2 && S.pos2) tags.push(["club2", `${S.club2} ${POS.find((p) => p[0] === S.pos2)![1]}`]);
    $("active").innerHTML = tags.map(([k, l]) => `<button type="button" class="fx-tag" data-k="${k}" aria-label="Zrušiť filter ${esc(l)}">${esc(l)}</button>`).join("") + (tags.length > 1 ? `<button type="button" class="fx-reset" id="reset">Zrušiť všetko</button>` : "");
    toUrl();
  }

  const set = (k: keyof typeof S, v: string) => { S[k] = v; if (k === "club" && !v) { S.pos = ""; S.club2 = ""; S.pos2 = ""; } if (k === "club2" && !v) S.pos2 = ""; if (k === "pos" && !v) { S.club2 = ""; S.pos2 = ""; } render(); };
  const onChip = (el: HTMLElement, k: "kind" | "res" | "when" | "pos" | "pos2", toggle = false) => el.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button[data-v]") as HTMLButtonElement | null; if (!b || b.disabled) return;
    set(k, toggle && S[k] === b.dataset.v ? "" : b.dataset.v!);
  });
  onChip($("f-kind"), "kind"); onChip($("f-res"), "res"); onChip($("f-when"), "when"); onChip($("f-pos"), "pos", true); onChip($("f-pos2"), "pos2", true);
  $("f-session").addEventListener("change", (e) => set("session", (e.target as HTMLSelectElement).value));
  $("f-club").addEventListener("change", (e) => { const v = (e.target as HTMLSelectElement).value; S.club = v; if (v && !S.pos) S.pos = "Z"; set("club", v); });
  $("f-club2").addEventListener("change", (e) => { const v = (e.target as HTMLSelectElement).value; if (v && !S.pos2) S.pos2 = S.pos === "Z" ? "P" : "Z"; set("club2", v); });
  $("sort").addEventListener("change", (e) => set("sort", (e.target as HTMLSelectElement).value));
  let t: number | undefined;
  $("q").addEventListener("input", (e) => { clearTimeout(t); t = window.setTimeout(() => set("q", (e.target as HTMLInputElement).value.trim()), 150); });
  $("q-clear").addEventListener("click", () => { set("q", ""); ($("q") as HTMLInputElement).focus(); });
  $("active").addEventListener("click", (e) => {
    const b = e.target as HTMLElement;
    if (b.id === "reset") { Object.assign(S, { q: "", kind: "", res: "", when: "", session: "", club: "", pos: "", club2: "", pos2: "" }); render(); return; }
    const k = b.dataset.k as keyof typeof S | undefined; if (k) set(k, "");
  });
  $("more").addEventListener("click", () => render(false));
  $("vl").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button[data-run]") as HTMLElement | null; if (!b) return;
    for (const li of $("vl").querySelectorAll<HTMLElement>(`li[data-in="${b.dataset.run}"]`)) li.hidden = false;
    b.parentElement!.remove();
  });
  new IntersectionObserver((es) => { if (es[0].isIntersecting && !$("more").hidden && shown > 0 && shown < 600) render(false); }, { rootMargin: "600px" }).observe($("more"));

  fromUrl();
  fetch("/hlasovania/data.json").then((r) => r.json()).then((d: { clubs: string[]; rows: Row[] }) => {
    rows = d.rows; clubs = d.clubs; search = rows.map((r) => words(`${r[2]} ${r[3]} ${r[4] ? `tlac ${r[4]}` : ""}`));
    const opts = clubs.map((c) => `<option value="${esc(c)}">${esc(c)}</option>`).join("");
    $("f-club").insertAdjacentHTML("beforeend", opts); $("f-club2").insertAdjacentHTML("beforeend", opts);
    render();
  });
</script>

<style>
  :global(#vl .res) { display: flex; flex-direction: column; align-items: flex-end; gap: .15rem; }
  :global(#vl .mg) { font-size: var(--step--2); color: var(--muted); }
  :global(#vl .fx-run) { display: block; padding: .35rem 0 .6rem 6.75rem; border-bottom: 1px solid var(--line); }
  :global(#vl .fx-run button) { font: inherit; font-size: var(--step--2); font-weight: 700; color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); border: 0; border-radius: 999px; padding: .3rem .75rem; cursor: pointer; }
  @media (max-width: 44rem) {
    :global(#vl li:not(.fx-day):not(.fx-run)) { grid-template-columns: 1fr auto; row-gap: .45rem; }
    :global(#vl li > time), :global(#vl .t) { grid-column: 1 / -1; }
    :global(#vl time) { font-size: var(--step--2); }
    :global(#vl .res) { flex-direction: row; align-items: center; gap: .5rem; }
    :global(#vl .fx-run) { padding-left: 0; }
  }
</style>
