---
import Base from "../../layouts/Base.astro";
import VoteList from "../../components/VoteList.astro";
import { votes, fmtDate } from "../../lib/data";
const byDay = new Map<string, typeof votes>();
for (const v of votes) { const d = fmtDate(v.datetime); byDay.set(d, [...(byDay.get(d) ?? []), v]); }
---
<Base title="Hlasovania" description="Všetky hlasovania Národnej rady SR s výsledkom a rozdelením hlasov.">
  <h1>Hlasovania</h1>
  <p class="meta-line">{votes.length} hlasovaní, od najnovších.</p>
  {[...byDay.entries()].map(([day, items]) => (
    <section>
      <h2 class="day">{day}</h2>
      <VoteList items={items} showDate={false} />
    </section>
  ))}
</Base>
