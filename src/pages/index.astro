---
import Base from "../layouts/Base.astro";
import Hall from "../components/Hall.astro";
import Ava from "../components/Ava.astro";
import VoteBar from "../components/VoteBar.astro";
import Timeline from "../components/Timeline.astro";
import SessionCard from "../components/SessionCard.astro";
import { voteHeadline, voteContext, mpTalk, fmtDur, votes, sessions, mps, mpStats, clubColor, initials, pct, fmtDate, fmtTime, fmtDay, dayKey, resultText, resultCls, shortTitle, CODES, LABEL, cls } from "../lib/data";
const latest = votes[0];
const s0 = sessions[0];
const lastDay = latest ? votes.filter((v) => dayKey(v.datetime) === dayKey(latest.datetime)).reverse() : [];
const passedShare = votes.length ? votes.filter((v) => v.passed).length / votes.length : null;
const avgAtt = votes.length ? votes.reduce((s, v) => s + (150 - v.counts["0"]) / 150, 0) / votes.length : null;
const ranked = (f: (id: string) => number) => mps.slice().sort((a, b) => f(b.id) - f(a.id)).slice(0, 5);
const lowAtt = ranked((id) => 1 - (mpStats(id).attendance ?? 1));
const rebels = ranked((id) => mpStats(id).rebels.length);
const talkers = ranked((id) => mpTalk(id).seconds).filter((m) => mpTalk(m.id).seconds > 0);
---
<Base>
  {latest ? (
    <>
      <section class="hero">
        <div class="intro">
          <div>
            <p class="kicker">Národná rada SR, IX. volebné obdobie</p>
            <h1>Kto ako hlasuje v parlamente</h1>
            <p class="lede">Každé hlasovanie, každý poslanec, každá schôdza. Prehľadne a s odkazom na zdroj.</p>
          </div>
          <dl class="tiles">
            <div class="tile"><dt>Hlasovaní</dt><dd>{votes.length.toLocaleString("sk-SK")}</dd></div>
            <div class="tile"><dt>Schôdzí</dt><dd>{sessions.length}</dd></div>
            <div class="tile"><dt>Schválených</dt><dd>{pct(passedShare)}</dd></div>
            <div class="tile accent"><dt>Priemerná účasť</dt><dd>{pct(avgAtt)}</dd></div>
          </dl>
        </div>
        <article class="panel latest">
          <p class="when">Posledné hlasovanie, {fmtDate(latest.datetime)} o {fmtTime(latest.datetime)}</p>
          <h2><a href={`/hlasovania/${latest.id}/`}>{shortTitle(voteHeadline(latest), 140)}</a>{voteContext(latest) && <small class="ctx" style="display:block;margin-top:.3rem;font-weight:500">{shortTitle(voteContext(latest)!, 150)}</small>}</h2>
          <Hall votes={latest.votes} clubsAt={latest.clubs} id="home-hall" intro />
          <div class="latest-foot">
            <span class={`pill ${resultCls(latest)}`} style="font-size:var(--step--1)">{resultText(latest)}</span>
            <span class="legend" style="margin:0">{CODES.map((c) => <span><i class={`dot v-${cls(c)}`}></i>{LABEL[c]} {latest.counts[c]}</span>)}</span>
          </div>
        </article>
      </section>

      <section id="follows" hidden>
        <div class="section-head"><h2>Poslanci, ktorých sledujete</h2><a href="/poslanci/">Pridať ďalších</a></div>
        <div class="follows" id="follows-list"></div>
      </section>
      <script>
        (async () => {
          let ids: string[] = []; try { ids = JSON.parse(localStorage.getItem("fp-follow") || "[]"); } catch {}
          if (!ids.length) return;
          const box = document.getElementById("follows")!, list = document.getElementById("follows-list")!;
          const el = (t: string, p: Record<string, any> = {}, ...k: (Node | string | null)[]) => { const e = document.createElement(t); Object.assign(e, p); for (const c of k) if (c != null) e.append(c); return e; };
          const data = (await Promise.all(ids.map((id) => fetch(`/poslanci/${id}/aktivita.json`).then((r) => (r.ok ? r.json() : null)).catch(() => null)))).filter(Boolean);
          for (const m of data) {
            const ava = el("span", { className: `ava${m.photo ? " img" : ""}`, ariaHidden: "true" }); if (m.photo) ava.append(el("img", { src: m.photo, alt: "" })); else ava.textContent = m.ini;
            const card = el("article", { className: "panel fcard" },
              el("header", {}, ava, el("div", {}, el("a", { href: `/poslanci/${m.id}/`, textContent: m.name }), el("small", { textContent: m.club }))),
              m.items.length ? el("ul", {}, ...m.items.map((i: any) => el("li", {}, el("a", { href: i.u }, el("b", { textContent: i.t }), el("span", { textContent: `${i.d.split("-").reverse().map(Number).join(". ")}: ${i.x}` })))))
                : el("p", { className: "empty", textContent: "Zatiaľ žiadna nová aktivita." }));
            card.style.setProperty("--club", m.color); list.append(card);
          }
          box.hidden = !data.length;
        })();
      </script>

      <div class="section-head"><h2>{fmtDay(latest.datetime)}</h2><a href={`/schodze/${latest.session}/`}>Celá {latest.session}. schôdza</a></div>
      <Timeline items={lastDay.slice(0, 12)} />

      <div class="section-head"><h2>Poslanci v číslach</h2><a href="/poslanci/">Celá sála</a></div>
      <div class="sessions">
        <section class="panel pad">
          <h3 style="font-size:var(--step-0)">Najnižšia účasť na hlasovaniach</h3>
          <ul class="mplist">{lowAtt.map((m) => (
            <li><a href={`/poslanci/#${m.id}`} style={`--club:${clubColor(m.club)};display:grid;grid-template-columns:auto 1fr auto;gap:.75rem;align-items:center;padding:.45rem 0;text-decoration:none`}>
              <Ava m={m} /><span><span class="nm">{m.name}</span><span class="cl">{m.club}</span></span><span class="val">{pct(mpStats(m.id).attendance)}</span></a></li>))}</ul>
        </section>
        <section class="panel pad">
          <h3 style="font-size:var(--step-0)">Najčastejšie hlasujú inak ako ich klub</h3>
          <ul class="mplist">{rebels.map((m) => (
            <li><a href={`/poslanci/#${m.id}`} style={`--club:${clubColor(m.club)};display:grid;grid-template-columns:auto 1fr auto;gap:.75rem;align-items:center;padding:.45rem 0;text-decoration:none`}>
              <Ava m={m} /><span><span class="nm">{m.name}</span><span class="cl">{m.club}</span></span><span class="val">{mpStats(m.id).rebels.length}<small>hlasovaní</small></span></a></li>))}</ul>
        </section>
      </div>

      {talkers.length > 0 && (
        <div class="sessions" style="margin-top:.9rem">
          <section class="panel pad">
            <h3 style="font-size:var(--step-0)">Najviac času pri rečníckom pulte</h3>
            <ul class="mplist">{talkers.map((m) => (
              <li><a href={`/poslanci/#${m.id}`} style={`--club:${clubColor(m.club)};display:grid;grid-template-columns:auto 1fr auto;gap:.75rem;align-items:center;padding:.45rem 0;text-decoration:none`}>
                <Ava m={m} /><span><span class="nm">{m.name}</span><span class="cl">{m.club}</span></span><span class="val">{fmtDur(mpTalk(m.id).seconds)}<small>{mpTalk(m.id).count} vystúpení</small></span></a></li>))}</ul>
          </section>
        </div>
      )}

      <div class="section-head"><h2>Schôdze</h2><a href="/schodze/">Všetky schôdze</a></div>
      <div class="sessions">{sessions.slice(0, 6).map((s) => <SessionCard s={s} />)}</div>
    </>
  ) : <p>Zatiaľ tu nie sú žiadne hlasovania.</p>}
</Base>
