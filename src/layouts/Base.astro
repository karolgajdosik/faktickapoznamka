---
import "@fontsource-variable/public-sans";
import "../styles/global.css";
import { meta, live } from "../lib/data";
import { versionInfo } from "../lib/build";
interface Props { title?: string; description?: string; wide?: boolean; ogImage?: string; index?: boolean }
const { title, description = "Ako hlasujú poslanci Národnej rady SR. Nezávislá, neoficiálna stránka s otvorenými dátami.", wide = false, ogImage = "/og/default.png", index = false } = Astro.props;
const full = title ? `${title} – faktická poznámka` : "faktická poznámka – ako hlasuje parlament";
const path = Astro.url.pathname;
const chips = [["/schodze/", "Schôdze"], ["/statistiky/", "Štatistiky"], ["/vybory/", "Výbory"], ["/kraje/", "Kraje"], ["/poslanci/zmeny/", "Zmeny v zložení"], ["/o-projekte/", "O projekte"]];
const nav = [["/poslanci/", "Sála"], ["/zakony/", "Zákony"], ["/schodze/", "Schôdze"], ["/vybory/", "Výbory"], ["/hlasovania/", "Hlasovania"], ["/statistiky/", "Štatistiky"], ["/hladat/", "Hľadať"], ["/o-projekte/", "O projekte"]];
---
<!doctype html>
<html lang="sk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="sk_SK" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="faktická poznámka" />
  <meta property="og:url" content={new URL(path, "https://faktickapoznamka.sk")} />
  <meta property="og:image" content={new URL(ogImage, "https://faktickapoznamka.sk")} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title="faktická poznámka – hlasovania" href="/rss.xml" />
  <meta name="theme-color" content="#0c111d" />
  <link rel="canonical" href={new URL(path, "https://faktickapoznamka.sk")} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="faktická poznámka" />
  <meta name="app-version" content={versionInfo.v} />
  <script is:inline>try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}</script>
</head>
<body>
  <a class="skip" href="#obsah">Preskočiť na obsah</a>
  <header class="site">
    <div class:list={["wrap head", { "wide-wrap": wide }]}>
      <a href="/" class="brand" aria-label="faktická poznámka, úvod">
        <img class="mark" src="/favicon.svg" alt="" width="30" height="30" />
        <span class="word">faktická poznámka</span>
      </a>
      <form class="m-search" action="/hladat/" method="get" role="search">
        <label class="sr-only" for="m-q">Hľadať</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="m-q" name="q" type="search" placeholder="Hľadať…" autocomplete="off" />
      </form>
      <button type="button" class="live-pill" id="live-pill" hidden aria-expanded="false" aria-controls="live"><span class="live-dot" aria-hidden="true"></span>Naživo</button>
      <nav class="main" aria-label="Hlavná navigácia">
        {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>)}
        <a href="https://tv.nrsr.sk/" rel="noopener" id="nav-live" hidden><span class="live-dot" aria-hidden="true"></span>Naživo</a>
      </nav>
      <nav class="m-chips" aria-label="Sekcie">
        {chips.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>)}
      </nav>
      <script is:inline>{(() => { const a = document.querySelector(".m-chips [aria-current]"); if (a) a.parentElement.scrollLeft = a.offsetLeft - 16; })()}</script>
      <button class="theme-btn" id="theme" type="button" aria-label="Prepnúť svetlý a tmavý režim"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg></button>
    </div>
  </header>
  <div id="live" class="live" hidden data-since={live.item ? live.since : ""}>
    <div class:list={["wrap", { "wide-wrap": wide }]}><strong>Na programe NR SR:</strong> {live.item} <a href="https://tv.nrsr.sk/" rel="noopener">Pozrieť prenos</a></div>
  </div>
  {meta.demo && <div class="demo"><div class="wrap">Ukážková verzia: mená a hlasovania sú vymyslené.</div></div>}
  <main id="obsah" class:list={["wrap", { "wide-wrap": wide }]} data-pagefind-body={index ? "" : undefined}><slot /></main>
  <div class="upd-bar" id="update" role="status" aria-live="polite" hidden>
    <span>Je k dispozícii nová verzia stránky.</span>
    <button type="button" class="btn" id="update-reload">Obnoviť</button>
  </div>
  <div class="upd-bar stale" id="stale" role="status" aria-live="polite" hidden>
    <span>Ste offline, zobrazujeme naposledy uložené údaje.</span>
    <button type="button" class="btn ghost" id="stale-close">Rozumiem</button>
  </div>
  <nav class="tabbar" aria-label="Rýchla navigácia">
    <a href="/poslanci/" aria-current={path.startsWith("/poslanci/") ? "page" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="4" cy="17" r="1.6"/><circle cx="6" cy="11" r="1.6"/><circle cx="10" cy="7.2" r="1.6"/><circle cx="14" cy="7.2" r="1.6"/><circle cx="18" cy="11" r="1.6"/><circle cx="20" cy="17" r="1.6"/><circle cx="9.5" cy="15" r="1.4"/><circle cx="14.5" cy="15" r="1.4"/></svg><span>Sála</span></a>
    <a href="/zakony/" aria-current={path.startsWith("/zakony/") ? "page" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5M10 16h5"/></svg><span>Zákony</span></a>
    <a href="/hlasovania/" aria-current={path.startsWith("/hlasovania/") ? "page" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg><span>Hlasovania</span></a>
    <a href="/sledujem/" aria-current={path.startsWith("/sledujem/") ? "page" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span>Sledujem</span></a>
    <button type="button" id="more-btn" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span>Viac</span></button>
  </nav>
  <dialog class="sheet" id="more" aria-label="Ďalšie stránky">
    <div class="sheet-grip" aria-hidden="true"></div>
    <a href="/">Úvod</a>
    <a href="/schodze/">Schôdze</a>
    <a href="/vybory/">Výbory</a>
    <a href="/kraje/">Poslanci podľa krajov</a>
    <a href="/poslanci/zmeny/">Zmeny v zložení parlamentu</a>
    <a href="/statistiky/">Štatistiky</a>
    <a href="/hladat/">Hľadať v prepisoch</a>
    <a href="/o-projekte/">O projekte</a>
    <a href="/rss.xml">RSS kanál hlasovaní</a>
    <button type="button" id="theme-m">Prepnúť svetlý a tmavý režim</button>
    <button type="button" class="sheet-close" data-close>Zavrieť</button>
    <p class="sheet-note">Neoficiálna, nezávislá stránka, nie je stránkou NR SR. Zdroj dát: <a href="https://www.nrsr.sk/">nrsr.sk</a>. Kód a dáta: <a href="https://github.com/karolgajdosik/faktickapoznamka">GitHub</a>. Aktualizované {new Date(meta.updatedAt).toLocaleString("sk-SK", { timeZone: "Europe/Bratislava", day: "numeric", month: "numeric", hour: "2-digit", minute: "2-digit" })}.</p>
  </dialog>
  <footer class="site">
    <div class="wrap">
      <p>Neoficiálna, nezávislá stránka. Nie je stránkou Národnej rady SR. Zdroj dát: <a href="https://www.nrsr.sk/">nrsr.sk</a>. Kód a dáta: <a href="https://github.com/karolgajdosik/faktickapoznamka">GitHub</a>.</p>
      <p>Dáta aktualizované {new Date(meta.updatedAt).toLocaleString("sk-SK", { timeZone: "Europe/Bratislava" })}. <a href="/o-projekte/">Metodika a kontakt</a></p>
    </div>
  </footer>
  <script>
    // Agenda strip only on session days: weekday, 8–20 h, item seen in the last 12 hours.
    const box = document.getElementById("live")!;
    const since = box.dataset.since;
    const now = new Date();
    const h = Number(now.toLocaleString("en-GB", { timeZone: "Europe/Bratislava", hour: "numeric", hour12: false }));
    const wd = now.toLocaleString("en-GB", { timeZone: "Europe/Bratislava", weekday: "short" });
    if (since && !["Sat", "Sun"].includes(wd) && h >= 8 && h < 20 && Date.now() - Date.parse(since) < 12 * 3600e3) {
      box.hidden = false; document.getElementById("nav-live")!.hidden = false;
      const pill = document.getElementById("live-pill")!; pill.hidden = false;
      pill.addEventListener("click", () => { const open = document.body.classList.toggle("live-open"); pill.setAttribute("aria-expanded", String(open)); });
    }
    // Mobile: hide the top bar while scrolling down, bring it back on scroll up.
    {
      const head = document.querySelector<HTMLElement>("header.site")!; let last = scrollY;
      addEventListener("scroll", () => {
        const y = scrollY; if (Math.abs(y - last) < 6) return;
        head.classList.toggle("tucked", y > last && y > 80); last = y;
      }, { passive: true });
      const sheet = document.getElementById("more") as HTMLDialogElement;
      document.getElementById("more-btn")!.addEventListener("click", () => sheet.showModal());
      sheet.addEventListener("click", (e) => { if (e.target === sheet || (e.target as Element).closest("[data-close]")) sheet.close(); });
      document.getElementById("theme-m")!.addEventListener("click", () => { document.getElementById("theme")!.click(); sheet.close(); });
    }
    // "Nová verzia" check: compare this page's <meta name="app-version"> with the one in a fresh "/".
    // Runs 20 s after load, every 5 minutes and on returning to the tab; never while hidden.
    {
      const mine = document.querySelector<HTMLMetaElement>('meta[name="app-version"]')?.content;
      const bar = document.getElementById("update")!;
      let shown = false;
      async function check() {
        if (!mine || shown || document.hidden) return;
        try {
          // tiny file with the current build id (no-store: always straight from the server)
          const r = await fetch(`/version.json?t=${Date.now()}`, { cache: "no-store" });
          if (!r.ok || r.redirected) return;
          const v = (await r.json()).v;
          if (!v || v === mine) return;
          shown = true; bar.hidden = false;
        } catch { /* offline */ }
      }
      setInterval(check, 5 * 60e3);
      document.addEventListener("visibilitychange", () => { if (!document.hidden) check(); });
      // iPhone: "Back" restores the old page from memory without reloading — check then too
      addEventListener("pageshow", (e) => { if ((e as PageTransitionEvent).persisted) check(); });
      addEventListener("focus", check);
      addEventListener("online", check);
      setTimeout(check, 20e3);
      document.getElementById("update-reload")!.addEventListener("click", () => location.reload());

      // Service worker: fast loads, offline fallback; tells us when it served a stored copy.
      if ("serviceWorker" in navigator) {
        const stale = document.getElementById("stale")!;
        navigator.serviceWorker.addEventListener("message", (e) => { if (e.data?.type === "stale") stale.hidden = false; });
        document.getElementById("stale-close")!.addEventListener("click", () => { stale.hidden = true; });
        addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
      }
    }
    document.getElementById("theme")!.addEventListener("click", () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === "dark" : !matchMedia("(prefers-color-scheme: light)").matches;
      root.dataset.theme = dark ? "light" : "dark";
      try { localStorage.setItem("theme", root.dataset.theme); } catch {}
    });
  </script>
</body>
</html>
