---
import "@fontsource-variable/public-sans";
import "../styles/global.css";
import { meta, live } from "../lib/data";
import { versionInfo } from "../lib/build";
interface Props { title?: string; description?: string; wide?: boolean; ogImage?: string; index?: boolean }
const { title, description = "Ako hlasujú poslanci Národnej rady SR. Nezávislá, neoficiálna stránka s otvorenými dátami.", wide = false, ogImage = "/og/default.png", index = false } = Astro.props;
const full = title ? `${title} – faktická poznámka` : "faktická poznámka – ako hlasuje parlament";
const path = Astro.url.pathname;
const chips = [["/schodze/", "Schôdze"], ["/statistiky/", "Štatistiky"], ["/vybory/", "Výbory"], ["/kraje/", "Kraje"]];
const nav = [["/poslanci/", "Sála"], ["/zakony/", "Zákony"], ["/schodze/", "Schôdze"], ["/vybory/", "Výbory"], ["/hlasovania/", "Hlasovania"], ["/majetok/", "Majetok"], ["/statistiky/", "Štatistiky"], ["/o-projekte/", "O projekte"]];
---
<!doctype html>
<html lang="sk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="sk_SK" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="faktická poznámka" />
  <meta property="og:url" content={new URL(path, "https://faktickapoznamka.sk")} />
  <meta property="og:image" content={new URL(ogImage, "https://faktickapoznamka.sk")} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title="faktická poznámka – hlasovania" href="/rss.xml" />
  <meta name="theme-color" content="#0c111d" />
  <link rel="canonical" href={new URL(path, "https://faktickapoznamka.sk")} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="faktická poznámka" />
  <meta name="app-version" content={versionInfo.v} />
  <script is:inline>try { const d = document.documentElement, t = localStorage.getItem("theme"), f = localStorage.getItem("fp-size"), c = localStorage.getItem("fp-contrast"), l = localStorage.getItem("fp-lang");
    if (t) d.dataset.theme = t; if (f) d.style.fontSize = f + "%"; if (c) d.dataset.contrast = c;
    if (l && /^(en|de|hu|pl)$/.test(l)) { d.dataset.lang = l; d.lang = l; d.classList.add("i18n-wait"); window.__fpDict = fetch("/i18n/" + l + ".json").then((r) => r.json());
      const s = document.createElement("script"); s.src = "/i18n/i18n.js?v=" + document.querySelector('meta[name="app-version"]')?.content; s.async = false; document.head.append(s); }
  } catch {}</script>
</head>
<body>
  <a class="skip" href="#obsah">Preskočiť na obsah</a>
  <header class="site">
    <div class:list={["wrap head", { "wide-wrap": wide }]}>
      <a href="/" class="brand" aria-label="faktická poznámka, úvod">
        <img class="mark" src="/favicon.svg" alt="" width="30" height="30" />
        <span class="word" translate="no">faktická poznámka</span>
      </a>
      <form class="m-search" action="/hladat/" method="get" role="search">
        <label class="sr-only" for="m-q">Hľadať</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="m-q" name="q" type="search" placeholder="Hľadať…" autocomplete="off" />
      </form>
      <button type="button" class="live-pill" id="live-pill" hidden aria-expanded="false" aria-controls="live"><span class="live-dot" aria-hidden="true"></span>Naživo</button>
      <nav class="main" aria-label="Hlavná navigácia">
        {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>)}
        <a href="https://tv.nrsr.sk/" rel="noopener" id="nav-live" hidden><span class="live-dot" aria-hidden="true"></span>Naživo</a>
      </nav>
      <nav class="m-chips" aria-label="Sekcie">
        {chips.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>)}
      </nav>
      <script is:inline>{(() => { const a = document.querySelector(".m-chips [aria-current]"); if (a) a.parentElement.scrollLeft = a.offsetLeft - 16; })()}</script>
      <button type="button" class="k-open" id="k-open" aria-haspopup="dialog" aria-controls="k-pal">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>Hľadať poslanca, zákon…</span><kbd id="k-key">Ctrl K</kbd>
      </button>
      <button class="theme-btn a11y-btn" id="a11y-open" type="button" aria-haspopup="dialog" aria-controls="a11y" aria-label="Zobrazenie: veľkosť písma, kontrast, režim a jazyk" title="Veľkosť písma, kontrast, jazyk"><span aria-hidden="true">Aa</span></button>
    </div>
  </header>
  <div id="live" class="live" hidden data-since={live.item ? live.since : ""}>
    <div class:list={["wrap", { "wide-wrap": wide }]}><strong>Na programe NR SR:</strong> {live.item} <a href="https://tv.nrsr.sk/" rel="noopener">Pozrieť prenos</a></div>
  </div>
  {meta.demo && <div class="demo"><div class="wrap">Ukážková verzia: mená a hlasovania sú vymyslené.</div></div>}
  <main id="obsah" class:list={["wrap", { "wide-wrap": wide }]} data-pagefind-body={index ? "" : undefined}><slot /></main>
  <div class="upd-bar" id="update" role="status" aria-live="polite" hidden>
    <span>Je k dispozícii nová verzia stránky.</span>
    <button type="button" class="btn" id="update-reload">Obnoviť</button>
  </div>
  <div class="upd-bar stale" id="stale" role="status" aria-live="polite" hidden>
    <span>Ste offline, zobrazujeme naposledy uložené údaje.</span>
    <button type="button" class="btn ghost" id="stale-close">Rozumiem</button>
  </div>
  <nav class="tabbar" aria-label="Rýchla navigácia">
    <a href="/poslanci/" aria-current={path.startsWith("/poslanci/") ? "page" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="4" cy="17" r="1.6"/><circle cx="6" cy="11" r="1.6"/><circle cx="10" cy="7.2" r="1.6"/><circle cx="14" cy="7.2" r="1.6"/><circle cx="18" cy="11" r="1.6"/><circle cx="20" cy="17" r="1.6"/><circle cx="9.5" cy="15" r="1.4"/><circle cx="14.5" cy="15" r="1.4"/></svg><span>Sála</span></a>
    <a href="/zakony/" aria-current={path.startsWith("/zakony/") ? "page" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5M10 16h5"/></svg><span>Zákony</span></a>
    <a href="/hlasovania/" aria-current={path.startsWith("/hlasovania/") ? "page" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg><span>Hlasovania</span></a>
    <a href="/majetok/" aria-current={path.startsWith("/majetok/") ? "page" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 4l9 6.5M5 9.5V20h14V9.5"/><path d="M10 20v-5h4v5"/></svg><span>Majetok</span></a>
    <button type="button" id="more-btn" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span>Viac</span></button>
  </nav>
  <dialog class="sheet" id="more" aria-label="Ďalšie stránky">
    <div class="sheet-grip" aria-hidden="true"></div>
    <a href="/">Úvod</a>
    <a href="/sledujem/">Sledujem</a>
    <a href="/schodze/">Schôdze</a>
    <a href="/vybory/">Výbory</a>
    <a href="/kraje/">Poslanci podľa krajov</a>
    <a href="/poslanci/zmeny/">Zmeny v zložení parlamentu</a>
    <a href="/statistiky/">Štatistiky</a>
    <a href="/porovnanie/">Porovnanie poslancov</a>
    <a href="/hladat/">Hľadať v prepisoch</a>
    <a href="/o-projekte/">O projekte</a>
    <a href="/rss.xml">RSS kanál hlasovaní</a>
    <a href="/ochrana-sukromia/">Ochrana súkromia</a>
    <button type="button" id="theme-m">Písmo, kontrast, jazyk a režim</button>
    <button type="button" class="sheet-close" data-close>Zavrieť</button>
    <p class="sheet-note">Neoficiálna, nezávislá stránka, nie je stránkou NR SR. Zdroj dát: <a href="https://www.nrsr.sk/">nrsr.sk</a>. Kód a dáta: <a href="https://github.com/karolgajdosik/faktickapoznamka">GitHub</a>. Aktualizované {new Date(meta.updatedAt).toLocaleString("sk-SK", { timeZone: "Europe/Bratislava", day: "numeric", month: "numeric", hour: "2-digit", minute: "2-digit" })}.</p>
  </dialog>
  <footer class="site">
    <div class="wrap">
      <p>Neoficiálna, nezávislá stránka. Nie je stránkou Národnej rady SR. Zdroj dát: <a href="https://www.nrsr.sk/">nrsr.sk</a>. Kód a dáta: <a href="https://github.com/karolgajdosik/faktickapoznamka">GitHub</a>.</p>
      <p>Dáta aktualizované {new Date(meta.updatedAt).toLocaleString("sk-SK", { timeZone: "Europe/Bratislava" })}. <a href="/o-projekte/">Metodika a kontakt</a> · <a href="/ochrana-sukromia/">Ochrana súkromia a prevádzkovateľ</a></p>
    </div>
  </footer>
  <script>
    // Filter forms are live; Enter must not reload the page.
    document.addEventListener("submit", (e) => { if ((e.target as Element).matches("form.fx")) e.preventDefault(); });
    // Agenda strip only on session days: weekday, 8–20 h, item seen in the last 12 hours.
    const box = document.getElementById("live")!;
    const since = box.dataset.since;
    const now = new Date();
    const h = Number(now.toLocaleString("en-GB", { timeZone: "Europe/Bratislava", hour: "numeric", hour12: false }));
    const wd = now.toLocaleString("en-GB", { timeZone: "Europe/Bratislava", weekday: "short" });
    if (since && !["Sat", "Sun"].includes(wd) && h >= 8 && h < 20 && Date.now() - Date.parse(since) < 12 * 3600e3) {
      box.hidden = false; document.getElementById("nav-live")!.hidden = false;
      const pill = document.getElementById("live-pill")!; pill.hidden = false;
      pill.addEventListener("click", () => { const open = document.body.classList.toggle("live-open"); pill.setAttribute("aria-expanded", String(open)); });
    }
    // Mobile: hide the top bar while scrolling down, bring it back on scroll up.
    {
      const head = document.querySelector<HTMLElement>("header.site")!; let last = scrollY;
      addEventListener("scroll", () => {
        const y = scrollY; if (Math.abs(y - last) < 6) return;
        head.classList.toggle("tucked", y > last && y > 80); last = y;
      }, { passive: true });
      const sheet = document.getElementById("more") as HTMLDialogElement;
      document.getElementById("more-btn")!.addEventListener("click", () => sheet.showModal());
      sheet.addEventListener("click", (e) => { if (e.target === sheet || (e.target as Element).closest("[data-close]")) sheet.close(); });
      document.getElementById("theme-m")!.addEventListener("click", () => { sheet.close(); document.getElementById("a11y-open")!.click(); });
    }
    // "Nová verzia" check: compare this page's <meta name="app-version"> with the one in a fresh "/".
    // Runs 20 s after load, every 5 minutes and on returning to the tab; never while hidden.
    {
      const mine = document.querySelector<HTMLMetaElement>('meta[name="app-version"]')?.content;
      const bar = document.getElementById("update")!;
      let shown = false;
      async function check() {
        if (!mine || shown || document.hidden) return;
        try {
          // tiny file with the current build id (no-store: always straight from the server)
          const r = await fetch(`/version.json?t=${Date.now()}`, { cache: "no-store" });
          if (!r.ok || r.redirected) return;
          const v = (await r.json()).v;
          if (!v || v === mine) return;
          shown = true; bar.hidden = false;
        } catch { /* offline */ }
      }
      setInterval(check, 5 * 60e3);
      document.addEventListener("visibilitychange", () => { if (!document.hidden) check(); });
      // iPhone: "Back" restores the old page from memory without reloading — check then too
      addEventListener("pageshow", (e) => { if ((e as PageTransitionEvent).persisted) check(); });
      addEventListener("focus", check);
      addEventListener("online", check);
      setTimeout(check, 20e3);
      document.getElementById("update-reload")!.addEventListener("click", () => location.reload());

      // Service worker: fast loads, offline fallback; tells us when it served a stored copy.
      if ("serviceWorker" in navigator) {
        const stale = document.getElementById("stale")!;
        navigator.serviceWorker.addEventListener("message", (e) => { if (e.data?.type === "stale") stale.hidden = false; });
        document.getElementById("stale-close")!.addEventListener("click", () => { stale.hidden = true; });
        addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
      }
    }
  </script>
  <dialog class="k-pal" id="k-pal" aria-label="Rýchle vyhľadávanie">
    <form method="dialog" class="k-box" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="k-q" type="search" placeholder="Meno poslanca, číslo tlače, výbor alebo slovo z rozpravy" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="k-list" aria-autocomplete="list" />
      <kbd>Esc</kbd>
    </form>
    <ul class="k-list" id="k-list" role="listbox"></ul>
    <div class="k-foot"><span><kbd>↑</kbd><kbd>↓</kbd> pohyb</span><span><kbd>Enter</kbd> otvoriť</span><span><kbd>Esc</kbd> zavrieť</span></div>
  </dialog>
  <script>
    // Command palette: instant MPs, prints, committees and sections; Enter on text = full-text search.
    type D = { mps: { id: string; n: string; c: string; col: string; p: string | null; i: string }[]; laws: [string, string, string][]; com: [number, string][] };
    const dlg = document.getElementById("k-pal") as HTMLDialogElement, q = document.getElementById("k-q") as HTMLInputElement, list = document.getElementById("k-list")!;
    const SECTIONS: [string, string, string][] = [["/poslanci/", "Sála", "poslanci sala"], ["/zakony/", "Zákony a návrhy", "zakony navrhy tlace"], ["/hlasovania/", "Hlasovania", "hlasovania"],
      ["/schodze/", "Schôdze a kalendár", "schodze kalendar program"], ["/vybory/", "Výbory", "vybory"], ["/majetok/", "Majetkové priznania", "majetok priznania prijmy"],
      ["/statistiky/", "Štatistiky", "statistiky rebricky"], ["/kraje/", "Poslanci podľa krajov", "kraje regiony"], ["/poslanci/zmeny/", "Zmeny v zložení parlamentu", "zmeny nahradnici mandat"],
      ["/sledujem/", "Sledovaní poslanci", "sledujem oblubeni"], ["/o-projekte/", "O projekte a metodika", "o projekte metodika kontakt"]];
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const norm = (s: string) => s.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();
    let data: D | null = null, items: { href: string; html: string }[] = [], sel = 0;
    const load = () => data ? Promise.resolve(data) : fetch("/hladat/data.json").then((r) => r.json()).then((d) => (data = d));
    const recent = () => { try { return JSON.parse(localStorage.getItem("fp-recent") ?? "[]") as string[]; } catch { return []; } };
    const remember = (t: string) => { try { localStorage.setItem("fp-recent", JSON.stringify([t, ...recent().filter((x) => x !== t)].slice(0, 6))); } catch {} };
    function draw() {
      const t = norm(q.value.trim()); const parts = t.split(/\s+/).filter(Boolean); const out: { g: string; href: string; html: string }[] = [];
      if (!t) {
        for (const r of recent().slice(0, 4)) out.push({ g: "Naposledy hľadané", href: `/hladat/?q=${encodeURIComponent(r)}`, html: `<span class="k-ic">↺</span><span>${esc(r)}</span>` });
        for (const [h, l] of SECTIONS.slice(0, 7)) out.push({ g: "Prejsť na", href: h, html: `<span class="k-ic">→</span><span>${l}</span>` });
      } else if (data) {
        for (const m of data.mps.filter((m) => { const w = norm(m.n).split(/\s+/); return parts.every((p) => w.some((x) => x.startsWith(p))); }).slice(0, 5))
          out.push({ g: "Poslanci", href: `/poslanci/${m.id}/`, html: `<span class="ava${m.p ? " img" : ""}" style="--club:${m.col}" aria-hidden="true">${m.p ? `<img src="${m.p}" alt="" width="36" height="36">` : esc(m.i)}</span><span><b>${esc(m.n)}</b><small>${esc(m.c)}</small></span>` });
        const num = t.match(/^(?:tl(?:ac)?\.?\s*)?(\d{1,4})$/);
        const laws = num ? data.laws.filter((l) => l[0] === num[1]) : t.length >= 3 ? data.laws.filter((l) => { const w = " " + norm(l[1]).replace(/[^a-z0-9]+/g, " "); return parts.every((p) => w.includes(" " + (p.length >= 6 ? p.slice(0, -2) : p))); }).slice(0, 4) : [];
        for (const l of laws) out.push({ g: "Zákony", href: `/zakony/${l[0]}/`, html: `<span class="k-tl">${l[0]}</span><span><b>${esc(l[1])}</b><small>${l[2]}</small></span>` });
        for (const c of data.com.filter((c) => t.length >= 3 && norm(c[1]).includes(t)).slice(0, 2)) out.push({ g: "Výbory", href: `/vybory/${c[0]}/`, html: `<span class="k-ic">▦</span><span>${esc(c[1])}</span>` });
        for (const [h, l, k] of SECTIONS.filter(([, l, k]) => parts.every((p) => k.includes(p) || norm(l).includes(p))).slice(0, 2)) out.push({ g: "Stránky", href: h, html: `<span class="k-ic">→</span><span>${l}</span>` });
        out.push({ g: "Fulltext", href: `/hladat/?q=${encodeURIComponent(q.value.trim())}`, html: `<span class="k-ic">⌕</span><span><span class="k-line">Hľadať „<b>${esc(q.value.trim())}</b>“ v prepisoch, zákonoch a schôdzach</span></span>` });
        out.push({ g: "Fulltext", href: `/hlasovania/?q=${encodeURIComponent(q.value.trim())}`, html: `<span class="k-ic">✓</span><span><span class="k-line">Hľadať „<b>${esc(q.value.trim())}</b>“ v hlasovaniach</span></span>` });
      }
      items = out; sel = 0; let g = "";
      list.innerHTML = out.map((x, i) => `${x.g !== g ? `<li class="k-g" role="presentation">${(g = x.g)}</li>` : ""}<li role="option" id="k-o${i}" aria-selected="${i === 0}"><a href="${x.href}" tabindex="-1">${x.html}</a></li>`).join("") || `<li class="k-g">Načítavam…</li>`;
      q.setAttribute("aria-activedescendant", out.length ? "k-o0" : "");
    }
    const move = (d: number) => {
      if (!items.length) return; sel = (sel + d + items.length) % items.length;
      for (const li of list.querySelectorAll('[role="option"]')) li.setAttribute("aria-selected", String(li.id === `k-o${sel}`));
      document.getElementById(`k-o${sel}`)?.scrollIntoView({ block: "nearest" }); q.setAttribute("aria-activedescendant", `k-o${sel}`);
    };
    const go = (href: string) => { if (q.value.trim()) remember(q.value.trim()); location.href = href; };
    function openPal() { if (dlg.open) return; q.value = ""; dlg.showModal(); draw(); load().then(draw); setTimeout(() => q.focus(), 10); }
    document.getElementById("k-open")!.addEventListener("click", openPal);
    document.getElementById("k-key")!.textContent = /Mac|iPhone|iPad/.test(navigator.platform) ? "⌘ K" : "Ctrl K";
    document.addEventListener("keydown", (e) => {
      if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) { e.preventDefault(); dlg.open ? dlg.close() : openPal(); }
      else if (e.key === "/" && !dlg.open && !(e.target as HTMLElement).matches("input, textarea, select") && location.pathname !== "/hladat/") { e.preventDefault(); openPal(); }
    });
    q.addEventListener("input", draw);
    q.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); move(1); } else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
      else if (e.key === "Enter") { e.preventDefault(); const it = items[sel]; if (it) go(it.href); }
    });
    list.addEventListener("click", (e) => { const a = (e.target as HTMLElement).closest("a"); if (a) { e.preventDefault(); go(a.getAttribute("href")!); } });
    list.addEventListener("mousemove", (e) => { const li = (e.target as HTMLElement).closest('[role="option"]'); if (li) { const i = Number(li.id.slice(3)); if (i !== sel) move(i - sel); } });
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  </script>
  <dialog class="a11y" id="a11y" aria-labelledby="a11y-h">
    <div class="a11y-head"><h2 id="a11y-h">Zobrazenie</h2><button type="button" class="a11y-x" data-close aria-label="Zavrieť">✕</button></div>
    <section>
      <h3>Veľkosť písma</h3>
      <div class="a11y-size" role="group" aria-label="Veľkosť písma">
        <button type="button" data-size="-1" aria-label="Zmenšiť písmo">A−</button>
        <output id="a11y-val" aria-live="polite">100 %</output>
        <button type="button" data-size="1" aria-label="Zväčšiť písmo">A+</button>
        <button type="button" class="a11y-reset" data-size="0">Pôvodná</button>
      </div>
    </section>
    <section>
      <h3>Pre slabozrakých</h3>
      <label class="a11y-sw"><input type="checkbox" id="a11y-contrast" /><span><b>Vysoký kontrast</b><small>Tmavší text, výraznejšie okraje a podčiarknuté odkazy</small></span></label>
      <label class="a11y-sw"><input type="checkbox" id="a11y-motion" /><span><b>Bez animácií</b><small>Vypne pohyb a prechody</small></span></label>
    </section>
    <section>
      <h3>Režim</h3>
      <div class="a11y-seg" role="group" aria-label="Farebný režim">
        <button type="button" data-theme-set="light">Svetlý</button><button type="button" data-theme-set="dark">Tmavý</button><button type="button" data-theme-set="" title="Podľa nastavenia systému">Automaticky</button>
      </div>
    </section>
    <section>
      <h3>Jazyk</h3>
      <div class="a11y-langs" translate="no">
        <a href="#" data-lang="sk" lang="sk"><span>SK</span>Slovenčina</a>
        <a href="#" data-lang="en" lang="en"><span>EN</span>English</a>
        <a href="#" data-lang="de" lang="de"><span>DE</span>Deutsch</a>
        <a href="#" data-lang="hu" lang="hu"><span>HU</span>Magyar</a>
        <a href="#" data-lang="pl" lang="pl"><span>PL</span>Polski</a>
      </div>
      <p class="a11y-note">Preložené je ovládanie stránky. Názvy zákonov, prepisy rozpravy a mená ostávajú po slovensky, tak ako ich zverejňuje NR SR.</p>
    </section>
    <section class="a11y-foot">
      <button type="button" class="a11y-resetall" id="a11y-resetall">↺ Obnoviť pôvodné nastavenia</button>
      <p class="a11y-note">Slovenčina, pôvodná veľkosť písma, bežný kontrast, animácie a farebný režim podľa systému.</p>
    </section>
  </dialog>
  <script>
    const d = document.documentElement, dlgA = document.getElementById("a11y") as HTMLDialogElement;
    const STEPS = [87.5, 100, 112.5, 125, 137.5, 150];
    const store = (k: string, v: string | null) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} };
    const cur = () => { const v = parseFloat(d.style.fontSize) || 100; return STEPS.reduce((a, b) => (Math.abs(b - v) < Math.abs(a - v) ? b : a)); };
    function paint() {
      const v = cur(); (document.getElementById("a11y-val") as HTMLOutputElement).value = `${v} %`;
      (dlgA.querySelector('[data-size="-1"]') as HTMLButtonElement).disabled = v === STEPS[0];
      (dlgA.querySelector('[data-size="1"]') as HTMLButtonElement).disabled = v === STEPS[STEPS.length - 1];
      (document.getElementById("a11y-contrast") as HTMLInputElement).checked = d.dataset.contrast === "high";
      (document.getElementById("a11y-motion") as HTMLInputElement).checked = d.dataset.motion === "off";
      const th = d.dataset.theme ?? "";
      for (const b of dlgA.querySelectorAll<HTMLElement>("[data-theme-set]")) b.setAttribute("aria-pressed", String(b.dataset.themeSet === th));
    }
    dlgA.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === dlgA || t.closest("[data-close]")) { dlgA.close(); return; }
      const sz = t.closest<HTMLElement>("[data-size]");
      if (sz) { const step = Number(sz.dataset.size); const i = STEPS.indexOf(cur()); const v = step === 0 ? 100 : STEPS[Math.max(0, Math.min(STEPS.length - 1, i + step))];
        d.style.fontSize = v === 100 ? "" : `${v}%`; store("fp-size", v === 100 ? null : String(v)); paint(); }
      const th = t.closest<HTMLElement>("[data-theme-set]");
      if (th) { const v = th.dataset.themeSet!; if (v) d.dataset.theme = v; else delete d.dataset.theme; store("theme", v || null); paint(); }
      const lang = t.closest<HTMLAnchorElement>("[data-lang]");
      if (lang) {
        e.preventDefault(); const l = lang.dataset.lang!;
        if ((d.dataset.lang ?? "sk") === l) { dlgA.close(); return; }
        store("fp-lang", l === "sk" ? null : l); location.reload();
      }
    });
    document.getElementById("a11y-contrast")!.addEventListener("change", (e) => { const on = (e.target as HTMLInputElement).checked; if (on) d.dataset.contrast = "high"; else delete d.dataset.contrast; store("fp-contrast", on ? "high" : null); });
    document.getElementById("a11y-motion")!.addEventListener("change", (e) => { const on = (e.target as HTMLInputElement).checked; if (on) d.dataset.motion = "off"; else delete d.dataset.motion; store("fp-motion", on ? "off" : null); });
    try { if (localStorage.getItem("fp-motion")) d.dataset.motion = "off"; } catch {}
    document.getElementById("a11y-open")!.addEventListener("click", () => { paint(); dlgA.showModal(); });
    for (const a of dlgA.querySelectorAll<HTMLAnchorElement>("[data-lang]")) a.setAttribute("aria-current", String(a.dataset.lang === (d.dataset.lang ?? "sk")));
    document.getElementById("a11y-resetall")!.addEventListener("click", () => {
      for (const k of ["fp-lang", "fp-size", "fp-contrast", "fp-motion", "theme"]) store(k, null);
      location.reload();
    });
  </script>
</body>
</html>
