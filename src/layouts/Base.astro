---
import "@fontsource-variable/public-sans";
import "../styles/global.css";
import { meta, live } from "../lib/data";
import { versionInfo } from "../lib/build";
interface Props { title?: string; description?: string; wide?: boolean }
const { title, description = "Ako hlasujú poslanci Národnej rady SR. Nezávislá, neoficiálna stránka s otvorenými dátami.", wide = false } = Astro.props;
const full = title ? `${title} – faktická poznámka` : "faktická poznámka – ako hlasuje parlament";
const path = Astro.url.pathname;
const nav = [["/poslanci/", "Sála"], ["/schodze/", "Schôdze"], ["/hlasovania/", "Hlasovania"], ["/o-projekte/", "O projekte"]];
---
<!doctype html>
<html lang="sk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="sk_SK" />
  <meta name="theme-color" content="#0c111d" />
  <link rel="canonical" href={new URL(path, "https://faktickapoznamka.sk")} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="faktická poznámka" />
  <meta name="app-version" content={versionInfo.v} />
  <script is:inline>try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}</script>
</head>
<body>
  <a class="skip" href="#obsah">Preskočiť na obsah</a>
  <header class="site">
    <div class:list={["wrap head", { "wide-wrap": wide }]}>
      <a href="/" class="brand" aria-label="faktická poznámka, úvod">
        <span class="word">faktická poznámka</span>
      </a>
      <nav class="main" aria-label="Hlavná navigácia">
        {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>)}
        <a href="https://tv.nrsr.sk/" rel="noopener" id="nav-live" hidden><span class="live-dot" aria-hidden="true"></span>Naživo</a>
      </nav>
      <button class="theme-btn" id="theme" type="button" aria-label="Prepnúť svetlý a tmavý režim"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg></button>
    </div>
  </header>
  <div id="live" class="live" hidden data-since={live.item ? live.since : ""}>
    <div class:list={["wrap", { "wide-wrap": wide }]}><strong>Na programe NR SR:</strong> {live.item} <a href="https://tv.nrsr.sk/" rel="noopener">Pozrieť prenos</a></div>
  </div>
  {meta.demo && <div class="demo"><div class="wrap">Ukážková verzia: mená a hlasovania sú vymyslené.</div></div>}
  <main id="obsah" class:list={["wrap", { "wide-wrap": wide }]}><slot /></main>
  <div class="upd-bar" id="update" role="status" aria-live="polite" hidden>
    <span>Je k dispozícii nová verzia stránky.</span>
    <button type="button" class="btn" id="update-reload">Obnoviť</button>
  </div>
  <div class="upd-bar stale" id="stale" role="status" aria-live="polite" hidden>
    <span>Ste offline, zobrazujeme naposledy uložené údaje.</span>
    <button type="button" class="btn ghost" id="stale-close">Rozumiem</button>
  </div>
  <footer class="site">
    <div class="wrap">
      <p>Neoficiálna, nezávislá stránka. Nie je stránkou Národnej rady SR. Zdroj dát: <a href="https://www.nrsr.sk/">nrsr.sk</a>. Kód a dáta: <a href="https://github.com/karolgajdosik/faktickapoznamka">GitHub</a>.</p>
      <p>Dáta aktualizované {new Date(meta.updatedAt).toLocaleString("sk-SK", { timeZone: "Europe/Bratislava" })}. <a href="/o-projekte/">Metodika a kontakt</a></p>
    </div>
  </footer>
  <script>
    // Agenda strip only on session days: weekday, 8–20 h, item seen in the last 12 hours.
    const box = document.getElementById("live")!;
    const since = box.dataset.since;
    const now = new Date();
    const h = Number(now.toLocaleString("en-GB", { timeZone: "Europe/Bratislava", hour: "numeric", hour12: false }));
    const wd = now.toLocaleString("en-GB", { timeZone: "Europe/Bratislava", weekday: "short" });
    if (since && !["Sat", "Sun"].includes(wd) && h >= 8 && h < 20 && Date.now() - Date.parse(since) < 12 * 3600e3) {
      box.hidden = false; document.getElementById("nav-live")!.hidden = false;
    }
    // "Nová verzia" check: compare this page's <meta name="app-version"> with the one in a fresh "/".
    // Runs 20 s after load, every 5 minutes and on returning to the tab; never while hidden.
    {
      const mine = document.querySelector<HTMLMetaElement>('meta[name="app-version"]')?.content;
      const bar = document.getElementById("update")!;
      let shown = false;
      async function check() {
        if (!mine || shown || document.hidden) return;
        try {
          const r = await fetch("/", { cache: "no-store" });
          if (!r.ok || r.redirected) return;
          const v = ((await r.text()).match(/<meta name="app-version" content="([^"]+)"/) || [])[1];
          if (!v || v === mine) return;
          shown = true; bar.hidden = false;
        } catch { /* offline */ }
      }
      setInterval(check, 5 * 60e3);
      document.addEventListener("visibilitychange", () => { if (!document.hidden) check(); });
      setTimeout(check, 20e3);
      document.getElementById("update-reload")!.addEventListener("click", () => location.reload());

      // Service worker: fast loads, offline fallback; tells us when it served a stored copy.
      if ("serviceWorker" in navigator) {
        const stale = document.getElementById("stale")!;
        navigator.serviceWorker.addEventListener("message", (e) => { if (e.data?.type === "stale") stale.hidden = false; });
        document.getElementById("stale-close")!.addEventListener("click", () => { stale.hidden = true; });
        addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
      }
    }
    document.getElementById("theme")!.addEventListener("click", () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === "dark" : !matchMedia("(prefers-color-scheme: light)").matches;
      root.dataset.theme = dark ? "light" : "dark";
      try { localStorage.setItem("theme", root.dataset.theme); } catch {}
    });
  </script>
</body>
</html>
