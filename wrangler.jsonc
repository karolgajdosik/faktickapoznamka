{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faktickapoznamka",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "faktickapoznamka.sk", "custom_domain": true },
    { "pattern": "www.faktickapoznamka.sk", "custom_domain": true }
  ],
  "durable_objects": { "bindings": [{ "name": "UPDATES", "class_name": "Updates" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Updates"] }],
  "observability": { "enabled": true }
}
