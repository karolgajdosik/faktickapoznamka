{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faktickapoznamka",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "faktickapoznamka.sk", "custom_domain": true },
    { "pattern": "www.faktickapoznamka.sk", "custom_domain": true }
  ],
  // v1 created the former WebSocket notifier, v2 removes it (replaced by the client-side version check).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Updates"] }, { "tag": "v2", "deleted_classes": ["Updates"] }],
  "observability": { "enabled": true },
  // newsletter subscribers (double opt-in), see worker/index.ts and scripts/newsletter.py
  "kv_namespaces": [{ "binding": "ODBER", "id": "1021f266cc084725846f34ca7716d352" }]
}
